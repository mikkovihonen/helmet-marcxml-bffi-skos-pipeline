# Pass 3: BFFI Manifestation CONSTRUCT (M3, P-45).
#
# Mints raw bffi:Manifestation URIs from the source bf:Instance URIs via
# arq:sha1 — same pattern as the Work + Expression passes, but keyed off
# ``#Instance`` not ``#Work``. Manifestations are 1:1 with Helmet bib
# records; there's no M8 merge step (unlike Works), so the raw URI minted
# here IS the canonical URI.
#
# This pass takes the third leg of the BFFI 4-class ontology
# (Work / Expression / Manifestation / Item) — the previous two-class
# build (Work + Expression only) collapsed Manifestation-level metadata
# into Work-side properties, which violated lkd.rdf's domain declarations
# for the 54 Manifestation-domain predicates.
#
# `bf:identifiedBy` (the Helmet bib_id) lives here — moved from Work +
# Expression. Rationale: a bib_id identifies a published embodiment, not
# the abstract work or expression. The canonical Work is discoverable
# from a bib_id by walking
# ``Manifestation → bffi:expressionManifested → Expression →
# (inverse bffi:hasExpression) → Work``.

PREFIX bf:    <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:  <http://id.loc.gov/ontologies/bflc/>
PREFIX bffi:  <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX arq:   <http://jena.apache.org/ARQ/function#>

CONSTRUCT {
  ?manifURI a bffi:Manifestation ;
            a                          ?manifSubclass ;
            a                          ?issuanceManifSubclass ;
            a                          ?carrierManifSubclass ;
            bffi:expressionManifested  ?exprURI ;
            bffi:identifiedBy          ?ident ;
            bffi:identifiedBy          ?isbn ;
            bffi:identifiedBy          ?audIssue ;
            bffi:identifiedBy          ?sysCtrl ;
            bffi:identifiedBy          ?issn ;
            bffi:identifiedBy          ?otherStd ;
            dct:identifier             ?helmetBibIdLiteral ;
            bf:issuance                ?issuance ;
            bffi:media                 ?mediaURI ;
            bffi:carrier               ?carrierURI ;
            bffi:digitalCharacteristic ?digitalCharURI ;
            bffi:soundCharacteristic   ?soundCharURI ;
            bffi:colorContent          ?colorContentURI ;
            bffi:provisionActivity     ?provisionActivity ;
            bffi:publicationStatement  ?publicationStatement ;
            bffi:responsibilityStatement ?responsibilityStatement ;
            bffi:extent                ?extent ;
            bffi:dimensions            ?dimensions ;
            bffi:tableOfContents       ?bfToc ;
            bffi:editionStatement      ?editionStatement ;
            bf:hasSeries               ?seriesNode ;
            bffi:note                  ?instanceNote ;
            bffi:relation              ?hubRel ;
            bffi:relation              ?relWorkRel ;
            bffi:adminMetadata         ?adminMeta ;
            bffi:title                 ?manifTitleNode ;
            skos:prefLabel             ?manifLabel .
  ?manifTitleNode a              bffi:Title ;
                  bffi:mainTitle ?manifMainTitle ;
                  bffi:subtitle  ?manifSubtitle .
  ?mediaURI   rdfs:label ?mediaLabel .
  ?carrierURI rdfs:label ?carrierLabel .
  ?adminMeta  a bffi:AdminMetadata ;
              bf:agent ?adminAgent ;
              bffi:descriptionLanguage    ?descLangURI ;
              bffi:descriptionConventions ?descConvURI ;
              bffi:changeDate             ?transactionDate ;
              bffi:encodingLevel          ?sourceEncodingLevel ;
              bffi:status                 ?recordStatus .
  ?adminAgent a bffi:Agent ;
              bffi:code ?adminAgencyCode .
  ?bfToc   a               bffi:TableOfContents ;
           rdfs:label      ?tocLabel .
  ?hubRel  a                       bffi:Relation ;
           bffi:relationship       ?hubRelationship ;
           bffi:associatedResource ?bfHub .
  ?bfHub   a               bf:Hub ;
           a               ?hubArrangementType ;
           bffi:title      ?bfHubTitle ;
           bflc:marcKey    ?hubMarcKey ;
           bf:language     ?hubLanguage ;
           bf:musicMedium  ?hubMusicMedium ;
           bf:keyMode      ?hubKeyMode ;
           bffi:version    ?hubVersion .
  ?hubLanguage a              bf:Language ;
               rdfs:label     ?hubLanguageLabel .
  ?hubMusicMedium a           bf:MusicMedium ;
                  rdfs:label  ?hubMusicMediumLabel .
  ?hubKeyMode a               bf:KeyMode ;
              rdfs:label      ?hubKeyModeLabel .
  ?bfHubTitle bffi:mainTitle  ?hubMainTitle ;
              bffi:partNumber ?hubPartNumber ;
              bffi:partName   ?hubPartName .
  ?relWorkRel a                    bffi:Relation ;
              bffi:relationship    ?relWorkRelationship ;
              bffi:associatedResource ?relWork .
  ?relWork    a               bf:Work ;
              bffi:title      ?relWorkTitle ;
              bflc:marcKey    ?relWorkMarcKey .
  ?relWorkTitle bffi:mainTitle  ?relWorkMainTitle ;
                bffi:partNumber ?relWorkPartNumber ;
                bffi:partName   ?relWorkPartName .
  ?extent  rdfs:label    ?extentLabel ;
           bf:note       ?extentNote .
  ?extentNote a          bffi:Note ;
              rdf:type   ?extentNoteType ;
              rdfs:label ?extentNoteLabel .
  ?provisionActivity a   ?provisionActivityType ;
                     bflc:simplePlace ?provisionPlace ;
                     bflc:simpleAgent ?provisionAgent ;
                     bflc:simpleDate  ?provisionDate ;
                     bflc:marcKey     ?provisionMarcKey ;
                     bf:date          ?provisionTypedDate ;
                     bf:place         ?provisionTypedPlace .
  ?instanceNote a        bffi:Note ;
                rdf:type ?instanceNoteType ;
                rdfs:label ?instanceNoteLabel .
  ?ident   a               bffi:Local ;
           rdf:value       ?identValue ;
           bf:source       ?identSource .
  ?isbn    a               bf:Isbn ;
           rdf:value       ?isbnValue ;
           bffi:qualifier  ?isbnQualifier .
  ?sysCtrl a               bffi:Local ;
           rdf:value       ?sysCtrlValue ;
           bffi:assigner   ?sysCtrlAssigner .
  ?sysCtrlAgent a          bffi:Agent ;
                bffi:code  ?sysCtrlAgentCode .
  ?audIssue a              bf:AudioIssueNumber ;
            rdf:value      ?audIssueValue .
  ?issn    a               bf:Issn ;
           rdf:value       ?issnValue .
  ?otherStd a              ?otherStdType ;
            rdf:value      ?otherStdValue .
  ?seriesNode a            bf:Series ;
              rdfs:label   ?seriesLabel .
}
WHERE {
  ?bfInstance a bf:Instance ;
              bf:instanceOf ?bfWork .

  # The instanceOf link tells us which raw bffi:Work this Manifestation
  # belongs to. We mint the matching bffi:Expression URI from the same
  # ?bfWork hash, mirroring bf_to_bffi_work.rq:
  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:manifestation:",
            arq:sha1(STR(?bfInstance)))) AS ?manifURI )
  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:expression:",
            arq:sha1(STR(?bfWork)))) AS ?exprURI )

  # P-52 Phase A — Manifestation-axis BFFI subclass typing. Five
  # carrier-form classes BFFI declares ``owl:equivalentClass`` of
  # their BIBFRAME counterparts:
  #   - bf:Print      → bffi:Print       (regular printed book)
  #   - bf:Electronic → bffi:Electronic  (online / digital file)
  #   - bf:Microform  → bffi:Microform   (microfilm / microfiche)
  #   - bf:Tactile    → bffi:Tactile     (Braille / embossed)
  #   - bf:Archival   → bffi:Archival    (archival-controlled)
  # marc2bibframe2 may attach the BIBFRAME class to either
  # ``?bfInstance`` (the natural BIBFRAME home for carrier form)
  # or ``?bfWork`` (older Helmet records that pre-date the routing
  # convention). UNION over both so we don't miss either shape.
  OPTIONAL {
    {
      ?bfInstance a ?bfManifClass .
    } UNION {
      ?bfWork a ?bfManifClass .
    }
    VALUES (?bfManifClass ?manifSubclass) {
      (bf:Print      bffi:Print)
      (bf:Electronic bffi:Electronic)
      (bf:Microform  bffi:Microform)
      (bf:Tactile    bffi:Tactile)
      (bf:Archival   bffi:Archival)
    }
  }

  # P-52 Phase C — issuance-derived Manifestation-axis typing.
  # ``bffi:CollectionManifestation`` for collection-issuance records.
  # Other issuance values don't carry a Manifestation-axis class in
  # BFFI (mono/serial are Work + Expression axes only).
  OPTIONAL {
    ?bfInstance bf:issuance ?issuanceUri .
    VALUES (?issuanceUri ?issuanceManifSubclass) {
      (<http://id.loc.gov/vocabulary/issuance/collection> bffi:CollectionManifestation)
    }
  }

  # P-52 Phase D — carrier-form-derived Manifestation typing.
  # MARC 008/23 form-of-item is the canonical source signal, but
  # marc2bibframe2 doesn't emit ``bf:Print`` / ``bf:Electronic`` etc.
  # on the bf:Instance. We infer from the LoC ``bffi:carrier`` URI
  # (which marc2bibframe2 DOES emit, derived from 338 / 008/23).
  # The mapping covers the dominant Helmet carriers; unmapped
  # carriers fall through to no Manifestation-axis typing — better
  # than guessing.
  OPTIONAL {
    ?bfInstance bf:carrier ?carrierUri .
    VALUES (?carrierUri ?carrierManifSubclass) {
      # nide / nb / no = regular printed volume / pamphlet / volume
      (<http://id.loc.gov/vocabulary/carriers/nc> bffi:Print)
      (<http://id.loc.gov/vocabulary/carriers/nb> bffi:Print)
      (<http://id.loc.gov/vocabulary/carriers/no> bffi:Print)
      # cr = online resource (typically electronic journals / ebooks)
      (<http://id.loc.gov/vocabulary/carriers/cr> bffi:Electronic)
      # cb = computer chip cartridge
      (<http://id.loc.gov/vocabulary/carriers/cb> bffi:Electronic)
      # ce = computer disc cartridge
      (<http://id.loc.gov/vocabulary/carriers/ce> bffi:Electronic)
      # he / hd / hf = microfilm reel / microfilm slip / microfilm cassette
      (<http://id.loc.gov/vocabulary/carriers/he> bffi:Microform)
      (<http://id.loc.gov/vocabulary/carriers/hd> bffi:Microform)
      (<http://id.loc.gov/vocabulary/carriers/hf> bffi:Microform)
      # hc / hb = microfiche cassette / microfiche
      (<http://id.loc.gov/vocabulary/carriers/hc> bffi:Microform)
      (<http://id.loc.gov/vocabulary/carriers/hb> bffi:Microform)
    }
  }

  # Helmet identifier — moved from Work + Expression to Manifestation
  # for BFFI 1.0.0 ontology fidelity. The bib_id identifies the
  # published artefact, not the abstract creative content.
  OPTIONAL {
    ?bfInstance bf:identifiedBy ?ident .
    ?ident  bf:source <http://urn.fi/URN:NBN:fi:bib:source:helmet> ;
            rdf:value ?identValue ;
            bf:source ?identSource .
    BIND(STR(?identValue) AS ?helmetBibIdLiteral)
  }
  # Fall back to the Work-side bf:identifiedBy when M2 attached the
  # Helmet identifier there (which is how M2 currently works — the
  # Helmet bib_id stays on bf:Work post-process). This OPTIONAL gives
  # us the same identifier shape regardless of which side M2 stamps.
  OPTIONAL {
    ?bfWork bf:identifiedBy ?ident .
    ?ident  bf:source <http://urn.fi/URN:NBN:fi:bib:source:helmet> ;
            rdf:value ?identValue ;
            bf:source ?identSource .
    BIND(STR(?identValue) AS ?helmetBibIdLiteral)
  }

  # RDA media + carrier — marc2bibframe2 deterministically resolves MARC
  # 337$b (media code) → ``bf:media`` URI in ``id.loc.gov/vocabulary/
  # mediaTypes/`` and MARC 338$b (carrier code) → ``bf:carrier`` URI in
  # ``id.loc.gov/vocabulary/carriers/``. Both URIs are already canonical
  # LoC RDA terms — no reconciliation needed; just forward them onto the
  # Manifestation under their BFFI parallels (which are ``bf:media`` /
  # ``bf:carrier`` subproperties per ``vocab/lkd.rdf``). Skosmos renders
  # them as labelled clickable concepts on the Manifestation page once
  # the RDA-Media + RDA-Carrier graphs are loaded by ``load-finto``
  # (commit 3 of this chain).
  OPTIONAL {
    ?bfInstance bf:media ?mediaURI .
    FILTER(isIRI(?mediaURI))
    # marc2bibframe2 attaches the Finnish source-MARC $a label
    # directly to the URI (``<…/mediaTypes/n> rdfs:label "käytettävissä
    # ilman laitetta"``). Pass it through so MARC 337 $a round-trips
    # without depending on the LoC vocab dump being loaded.
    OPTIONAL { ?mediaURI rdfs:label ?mediaLabel }
  }
  OPTIONAL {
    ?bfInstance bf:carrier ?carrierURI .
    FILTER(isIRI(?carrierURI))
    OPTIONAL { ?carrierURI rdfs:label ?carrierLabel }
  }

  # MARC 007-derived format details lifted by marc2bibframe2:
  #   ``bf:digitalCharacteristic`` → LoC ``mencformat`` URIs (DVD,
  #       Blu-ray, etc. — the user-visible "DVD vs Blu-ray" distinction
  #       that the coarse RDA carrier ``vd`` collapses).
  #   ``bf:soundCharacteristic`` → LoC ``mrecmedium`` / ``mplayspeed``
  #       / ``mplayback`` / ``mcapturestorage`` URIs. Same predicate
  #       on the source side; the object URI's namespace tells which
  #       facet (medium / speed / channels / capture) is being
  #       expressed. CD vs vinyl is the speed facet (mplayspeed/f =
  #       1.4 m/s = CD; mplayspeed/b = 33⅓ rpm = LP).
  #   ``bf:colorContent`` → LoC ``mcolor`` URIs (color vs B&W).
  # All three forwarded verbatim onto the Manifestation; Skosmos
  # resolves the labels via the LoC vocabs loaded by ``load-finto``.
  OPTIONAL { ?bfInstance bf:digitalCharacteristic ?digitalCharURI .
             FILTER(isIRI(?digitalCharURI)) }
  OPTIONAL { ?bfInstance bf:soundCharacteristic   ?soundCharURI .
             FILTER(isIRI(?soundCharURI)) }
  OPTIONAL { ?bfInstance bf:colorContent          ?colorContentURI .
             FILTER(isIRI(?colorContentURI)) }

  # MARC 260 / 264 / 300 / 245 $c → bf:Instance predicates that
  # marc2bibframe2 lifts; M3's Manifestation pass forwards them onto
  # BFFI so the round-trip MARC reconstruction (P-47) can rebuild
  # 260 / 264 / 300 / 245 $c subfields from the canonical graph.
  # Each OPTIONAL — the source bib may not have any given subfield.
  # MARC 260 / 264 — provision activity (publication / production /
  # distribution / manufacture). marc2bibframe2 emits one
  # ``bf:ProvisionActivity`` blank node per source field with:
  #   - ``rdf:type bf:Publication`` (or Production, Manufacture, ...)
  #   - ``bflc:simplePlace`` → $a
  #   - ``bflc:simpleAgent`` → $b
  #   - ``bflc:simpleDate``  → $c
  #   - ``bflc:marcKey`` carrying the source MARC tag (260 vs 264)
  # We route the inner subfield literals + type so the round-trip
  # converter can emit ``$a $b $c`` separately (rather than
  # collapsing them into the ``bffi:publicationStatement`` literal
  # which marc2bibframe2 also emits as a flat string).
  OPTIONAL {
    ?bfInstance bf:provisionActivity ?provisionActivity .
    OPTIONAL {
      ?provisionActivity a ?provisionActivityType .
      FILTER(STRSTARTS(STR(?provisionActivityType),
                       "http://id.loc.gov/ontologies/bibframe/"))
    }
    OPTIONAL { ?provisionActivity bflc:simplePlace ?provisionPlace }
    OPTIONAL { ?provisionActivity bflc:simpleAgent ?provisionAgent }
    OPTIONAL { ?provisionActivity bflc:simpleDate  ?provisionDate }
    OPTIONAL { ?provisionActivity bflc:marcKey     ?provisionMarcKey }
    # Typed-value siblings used by the round-trip converter to
    # reconstruct MARC 008 positions:
    #   bf:date  → Date1 (008 pos 07-10, 4-char publication year)
    #   bf:place → country code (008 pos 15-17, URI tail of
    #              ``…/vocabulary/countries/<code>``)
    OPTIONAL { ?provisionActivity bf:date  ?provisionTypedDate }
    OPTIONAL {
      ?provisionActivity bf:place ?provisionTypedPlace .
      FILTER(isIRI(?provisionTypedPlace))
    }
  }

  # MARC 008 pos 00-05 (date entered on file, YYMMDD) + LDR/05
  # (record status). marc2bibframe2 emits the source 005 timestamp
  # AND the source LDR/05 status code on the same AdminMetadata
  # block. The source-side block has ``bf:date`` (the source 005
  # timestamp). A sibling block represents marc2bibframe2's own
  # conversion event with ``bf:status mstatus/c`` and no source
  # date — distinguishable by the presence of ``bf:date``.
  OPTIONAL {
    ?bfWork bf:adminMetadata ?txAdmin .
    ?txAdmin bf:status ?recordStatus ;
             bf:date   ?transactionDate .
  }
  # MARC LDR/17 — encoding level. marc2bibframe2 emits the
  # cataloguer-typed source value as ``bflc:encodingLevel`` on the
  # ``bf:Instance``'s AdminMetadata sibling, pointing at
  # ``http://id.loc.gov/vocabulary/menclvl/<code>`` where ``<code>``
  # is the LDR/17 character verbatim. lkd.rdf declares
  # ``bffi:encodingLevel`` as ``owl:equivalentProperty`` of
  # ``bflc:encodingLevel`` so we route under the BFFI name onto the
  # canonical AdminMetadata block. Coexists with the pipeline's own
  # ``bffi:encodingLevel <…/enc-level/auto>`` marker — multiple
  # values are legal on the predicate; the round-trip converter
  # picks the menclvl-namespaced one.
  OPTIONAL {
    ?bfInstance bf:adminMetadata ?encAdmin .
    ?encAdmin bflc:encodingLevel ?sourceEncodingLevel .
    FILTER(isIRI(?sourceEncodingLevel))
  }
  OPTIONAL { ?bfInstance bf:publicationStatement   ?publicationStatement }
  # MARC LDR/07 — bibliographic level. marc2bibframe2 emits the
  # source's issuance code as ``bf:issuance`` on the bf:Instance,
  # pointing at ``http://id.loc.gov/vocabulary/issuance/<code>``
  # (e.g. ``mono`` for monograph). Routed verbatim onto the canonical
  # Manifestation; round-trip converter maps the URI tail to the
  # LDR/07 character.
  OPTIONAL {
    ?bfInstance bf:issuance ?issuance .
    FILTER(isIRI(?issuance))
  }
  OPTIONAL { ?bfInstance bf:responsibilityStatement ?responsibilityStatement }
  # MARC 300 $a (extent) lives on ``bf:Extent.rdfs:label``; MARC
  # 300 $b (other physical details) lives in a nested
  # ``bf:Extent → bf:note → bf:Note [a mnotetype/physical]
  # rdfs:label "kuvitettu"`` block. The CONSTRUCT template
  # passes the nested chain through verbatim (with the
  # ``rdf:type <mnotetype/physical>`` discriminator preserved) so
  # the round-trip converter can route them to $a / $b.
  OPTIONAL {
    ?bfInstance bf:extent ?extent .
    OPTIONAL { ?extent rdfs:label ?extentLabel }
    OPTIONAL {
      ?extent bf:note ?extentNote .
      OPTIONAL { ?extentNote rdfs:label ?extentNoteLabel }
      OPTIONAL { ?extentNote rdf:type ?extentNoteType .
                 FILTER(?extentNoteType != bf:Note) }
    }
  }
  OPTIONAL { ?bfInstance bf:dimensions             ?dimensions }

  # MARC 505 (formatted contents note) → marc2bibframe2 emits
  # ``bf:tableOfContents`` on the bf:Work side as a bf:TableOfContents
  # blank node with ``rdfs:label`` carrying the full track listing /
  # chapter list / item enumeration. BFFI declares
  # ``bffi:tableOfContents`` with ``rdfs:domain bffi:Manifestation``
  # (per vocab/lkd.rdf line 3995-ish), so we hoist the predicate from
  # the source bf:Work onto the canonical bffi:Manifestation here —
  # same Work→Manifestation hoist pattern bf_to_bffi_work.rq uses for
  # bf:originPlace. The single-string blob preserves whatever
  # cataloguers typed in MARC 505 $a; per-item structured emission
  # (505 $t / $r / $g) is intentionally not attempted (would need
  # parsing the source ``" / "`` separators heuristically, and the
  # rdfs:label round-trips losslessly as a single $a).
  OPTIONAL {
    ?bfWork bf:tableOfContents ?bfToc .
    ?bfToc rdfs:label ?tocLabel .
  }

  # MARC 020 (ISBN). marc2bibframe2 emits ``bf:Isbn`` identifiers on
  # bf:Instance without a ``bf:source`` (unlike the Helmet bib_id
  # which IS sourced). The existing ?ident OPTIONAL filters on
  # bf:source = <helmet>, so the ISBN gets dropped at the M3
  # boundary. Route it here on a separate variable so the round-trip
  # converter can emit 020 $a.
  OPTIONAL {
    ?bfInstance bf:identifiedBy ?isbn .
    ?isbn a bf:Isbn ;
          rdf:value ?isbnValue .
    OPTIONAL { ?isbn bf:qualifier ?isbnQualifier }
  }

  # MARC 035 (system control number, ``(SOURCE)VALUE`` format).
  # marc2bibframe2 emits these as ``bf:identifiedBy → bf:Local →
  # rdf:value + bf:assigner``. The assigner is either a LoC
  # organizations URI (``<…/organizations/fimelinda>``) — in which
  # case the round-trip converter derives the MARC code from the
  # URI tail / table — or a ``bf:Agent`` blank node carrying
  # ``bf:code "FI-BTJ"`` (used when marc2bibframe2 doesn't know the
  # LoC URI). We pass both shapes through and let the converter
  # format the ``(CODE)VALUE`` string.
  #
  # The Helmet bib_id (also a bf:Local on bf:Instance) is filtered
  # out by requiring ``bf:assigner`` — Helmet's identifier uses
  # ``bf:source <…/source:helmet>`` instead.
  OPTIONAL {
    ?bfInstance bf:identifiedBy ?sysCtrl .
    ?sysCtrl a bf:Local ;
             rdf:value ?sysCtrlValue ;
             bf:assigner ?sysCtrlAssigner .
    OPTIONAL {
      ?sysCtrlAssigner bf:code ?sysCtrlAgentCode .
      BIND(?sysCtrlAssigner AS ?sysCtrlAgent)
    }
  }

  # MARC 040 cataloging source. The source 040 $a / $b / $e live in
  # different bf:adminMetadata blocks emitted by marc2bibframe2:
  #   $a (cataloging agency) → bf:adminMetadata → bf:AdminMetadata
  #                            → bf:agent → bf:Agent → bf:code
  #   $b (lang of cataloging) → bf:adminMetadata → bf:AdminMetadata
  #                            → bf:descriptionLanguage
  #   $e (descr conventions) → bf:adminMetadata → bf:AdminMetadata
  #                            → bf:descriptionConventions
  # We aggregate them onto a single canonical bffi:AdminMetadata
  # block via a deterministic SHA-1-derived URI (per bf:Instance) so
  # multiple OPTIONALs all add triples to the same node — graph
  # dedup makes this safe across cross-product solution rows.
  BIND(IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:adminmeta/",
                  arq:sha1(STR(?bfInstance)))) AS ?adminMeta)
  OPTIONAL {
    ?bfWork bf:adminMetadata ?srcAdminBlock1 .
    ?srcAdminBlock1 bf:agent ?adminAgent .
    ?adminAgent bf:code ?adminAgencyCode .
  }
  OPTIONAL {
    ?bfWork bf:adminMetadata ?srcAdminBlock2 .
    ?srcAdminBlock2 bf:descriptionLanguage ?descLangURI .
  }
  OPTIONAL {
    ?bfWork bf:adminMetadata ?srcAdminBlock3 .
    ?srcAdminBlock3 bf:descriptionConventions ?descConvURI .
  }

  # MARC 028 (publisher / issue number for music + video). Source has
  # ``bf:identifiedBy [a bf:AudioIssueNumber; rdf:value "AM950224"]``.
  # Same routing rationale as ISBN — no ``bf:source`` triple, so the
  # existing ?ident OPTIONAL drops it.
  OPTIONAL {
    ?bfInstance bf:identifiedBy ?audIssue .
    ?audIssue a bf:AudioIssueNumber ;
              rdf:value ?audIssueValue .
  }

  # MARC 022 (ISSN — serials). marc2bibframe2 emits
  # ``bf:identifiedBy → bf:Issn`` (or ``bf:IssnL`` for ind1=0).
  # Per L-08 (BFFI namespace closed set), ``bf:Issn`` has no
  # ``bffi:*`` alias in ``vocab/lkd.rdf`` so we re-emit it under
  # ``bf:Issn``. P-54 Phase 2.
  OPTIONAL {
    ?bfInstance bf:identifiedBy ?issn .
    ?issn a bf:Issn ;
          rdf:value ?issnValue .
  }

  # MARC 024 (Other Standard Identifier). marc2bibframe2 emits a
  # type-by-indicator subclass: ind1=3 → ``bf:Ean``, ind1=0/1/2/8 →
  # ``bf:Identifier`` (or a more specific subclass when the source
  # vocabulary is known). We carry through the typing as-is so the
  # round-trip can route to the appropriate $2-discriminator if
  # present. P-54 Phase 2.
  OPTIONAL {
    ?bfInstance bf:identifiedBy ?otherStd .
    ?otherStd a ?otherStdType ;
              rdf:value ?otherStdValue .
    FILTER(?otherStdType IN (bf:Ean, bf:OtherIdentifier))
  }

  # MARC 250 (edition statement). marc2bibframe2 puts this as a flat
  # literal ``bf:editionStatement`` on bf:Instance (no blank-node
  # wrapper). The literal preserves the cataloguer's typed text
  # ("94. vsk.", "2nd edition", "Rev. ed.").
  OPTIONAL { ?bfInstance bf:editionStatement ?editionStatement }

  # MARC 490 (series statement). marc2bibframe2 routes series under
  # ``bf:Instance → bf:relation → bf:Relation → bf:associatedResource
  # → bf:Series → bf:title → bf:Title → bf:mainTitle "Usborne lots
  # of things to know"``. We collapse the chain by passing the source
  # ``bf:Series`` bnode through as ``?bfSeries`` and emit a flat
  # ``rdfs:label`` on it; rdflib graph semantics dedupe identical
  # triples so the cross-product blow-up from multiple OPTIONALs
  # doesn't matter (no BNODE() mint needed). BFFI doesn't have a
  # dedicated Series class — bf:Series is modelled by analogy to
  # bf:Series.
  OPTIONAL {
    ?bfWork bf:relation ?seriesRel .
    ?seriesRel bf:associatedResource ?seriesNode .
    ?seriesNode a bf:Series ;
                bf:title ?bfSeriesTitle .
    ?bfSeriesTitle bf:mainTitle ?seriesLabel .
  }

  # MARC 500 (general note) + MARC 300 $e (accompanying material)
  # when attached to bf:Instance. The Expression-side CONSTRUCT
  # already routes bf:Work notes; bf:Instance notes carry both
  # generic notes ("Cd-levyllä laulujen taustat" → 500) and
  # accompanying-material notes ("1 CD-äänilevy", typed as
  # ``rdf:type <mnotetype/accmat>`` → 300 $e). The CONSTRUCT
  # passes the ``rdf:type`` discriminator through so the round-trip
  # converter can dispatch each note to the right tag.
  OPTIONAL {
    ?bfInstance bf:note ?instanceNote .
    ?instanceNote rdfs:label ?instanceNoteLabel .
    OPTIONAL { ?instanceNote rdf:type ?instanceNoteType .
               FILTER(?instanceNoteType != bf:Note) }
  }

  # MARC 730 (added entry — uniform title): marc2bibframe2 emits these
  # as ``bf:Instance → bf:relation → bf:Relation`` chains whose
  # ``bf:associatedResource`` is a ``bf:Hub`` URI minted in the raw
  # bib namespace as ``#Hub730-N``. The Hub carries ``bf:title →
  # bf:Title → bf:mainTitle "<title> / <responsibility>"`` plus a
  # ``bflc:marcKey`` with the original MARC subfield string. Route
  # the whole chain onto the canonical ``bffi:Manifestation`` using
  # BFFI 1.0.0's relation pattern (``bffi:relation →
  # bffi:Relation → bffi:relationship + bffi:associatedResource``),
  # which is ``owl:equivalentProperty``/``owl:equivalentClass`` to
  # the BIBFRAME counterparts per ``vocab/lkd.rdf``. The Hub itself
  # stays a ``bf:Hub`` because BFFI has no Hub equivalent — the
  # blank-node Title substructure is also passed through verbatim
  # (the round-trip converter reads ``bf:mainTitle`` + ``bflc:marcKey``
  # to reconstruct ``$a`` / ``$g``).
  #
  # Filter on the Hub type so this OPTIONAL doesn't match the
  # ``bf:Series`` chain routed separately above (490 series; Series
  # uses a flatter ``bf:hasSeries`` model).
  OPTIONAL {
    ?bfWork bf:relation ?hubRel .
    ?hubRel bf:associatedResource ?bfHub .
    ?bfHub a bf:Hub .
    OPTIONAL { ?hubRel bf:relationship ?hubRelationship }
    # P-49 Layer 1: pass structured bf:partNumber / bf:partName through
    # so the round-trip converter emits 730 $n / $p from BFFI predicates
    # rather than parsing them out of bflc:marcKey.
    OPTIONAL {
      ?bfHub bf:title ?bfHubTitle .
      ?bfHubTitle bf:mainTitle ?hubMainTitle .
      OPTIONAL { ?bfHubTitle bf:partNumber ?hubPartNumber }
      OPTIONAL { ?bfHubTitle bf:partName   ?hubPartName }
    }
    OPTIONAL { ?bfHub bflc:marcKey ?hubMarcKey }
    # Structured-predicate passthrough for MARC 730 $l / $m / $r / $s / $o.
    # marc2bibframe2 emits these on the bf:Hub alongside the marcKey;
    # propagating them lets the round-trip read structured BFFI/BIBFRAME
    # predicates instead of parsing marcKey. See docs/bffi_limitations.md
    # L-13 for the per-subfield mapping rationale ($r → bf:keyMode rather
    # than bffi:musicKey because the BFFI alias only matches the legacy
    # bf:musicKey literal shape, not bf:keyMode's structured class).
    OPTIONAL {
      ?bfHub bf:language ?hubLanguage .
      ?hubLanguage a bf:Language ; rdfs:label ?hubLanguageLabel .
    }
    OPTIONAL {
      ?bfHub bf:musicMedium ?hubMusicMedium .
      ?hubMusicMedium a bf:MusicMedium ; rdfs:label ?hubMusicMediumLabel .
    }
    OPTIONAL {
      ?bfHub bf:keyMode ?hubKeyMode .
      ?hubKeyMode a bf:KeyMode ; rdfs:label ?hubKeyModeLabel .
    }
    OPTIONAL { ?bfHub bf:version ?hubVersion }
    OPTIONAL {
      ?bfHub a ?hubArrangementType .
      FILTER(?hubArrangementType = bf:Arrangement)
    }
  }

  # MARC 740 (added entry — uncontrolled related/analytical title).
  # Structurally identical to 730 in BIBFRAME but the target is a
  # ``bf:Work`` URI (``#Work740-N``) instead of a ``bf:Hub`` —
  # marc2bibframe2 mints a Work for the cataloguer's free-text
  # related-title entry, distinct from the uniform-title Hubs that
  # 730 produces. The main bf:Work CONSTRUCT in bf_to_bffi_work.rq
  # already FILTER-NOT-EXISTS-skips these (their `?ref
  # bf:associatedResource ?bfWork` link makes them
  # contained/related Works, never minted as bffi:Works), so the
  # raw URI exists in the source graph but has no canonical Work
  # role — perfect for the same pass-through routing as Hubs.
  OPTIONAL {
    ?bfWork bf:relation ?relWorkRel .
    ?relWorkRel bf:associatedResource ?relWork .
    ?relWork a bf:Work .
    OPTIONAL { ?relWorkRel bf:relationship ?relWorkRelationship }
    # P-49 Layer 1: pass structured bf:partNumber / bf:partName for
    # 740 $n / $p (parallel to 730 above).
    OPTIONAL {
      ?relWork bf:title ?relWorkTitle .
      ?relWorkTitle bf:mainTitle ?relWorkMainTitle .
      OPTIONAL { ?relWorkTitle bf:partNumber ?relWorkPartNumber }
      OPTIONAL { ?relWorkTitle bf:partName   ?relWorkPartName }
    }
    OPTIONAL { ?relWork bflc:marcKey ?relWorkMarcKey }
  }

  # Skosmos display label. Without ``skos:prefLabel`` Skosmos renders
  # Manifestations as their bare URI. We synthesise the label from the
  # bf:Instance's title and (when present) its publication statement,
  # giving the cataloguer something like "AADA WILDE (1912)" — distinct
  # from the Work / Expression labels when the same intellectual content
  # has multiple published editions of the same translation. Untagged
  # literal (no @fi/@en) because bf:Instance's bf:title doesn't carry a
  # language tag from marc2bibframe2; Skosmos falls back to no-lang
  # labels when no language-specific prefLabel is present.
  OPTIONAL {
    ?bfInstance bf:title ?titleNode .
    ?titleNode bf:mainTitle ?titleLit .
  }

  # Manifestation-side structured title — round-trip 245 $a / $b.
  #
  # marc2bibframe2 emits two parallel titles per record:
  #
  #   bf:Instance  bf:title  bf:Title  bf:mainTitle "Foo"
  #                                     bf:subtitle "Bar baz"     ← transcribed (245 $a / $b)
  #   bf:Work      bf:title  bf:Title  bf:mainTitle "Foo : Bar baz"  ← concatenated (canonical)
  #
  # The transcribed form on bf:Instance is what carries the original
  # subfield boundary; the converter needs it to emit 245 with
  # separate $a and $b. We mint a Manifestation-scoped Title bnode-IRI
  # (sha1 of the source bf:Title node) so the canonical graph can
  # ``DESCRIBE`` the manifestation without dragging in cross-record
  # bnode shapes.
  OPTIONAL {
    ?bfInstance bf:title ?bfInstanceTitle .
    ?bfInstanceTitle a bf:Title ;
                     bf:mainTitle ?manifMainTitle .
    OPTIONAL { ?bfInstanceTitle bf:subtitle ?manifSubtitle }
    BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:manifestation:",
              arq:sha1(STR(?bfInstance)), "#title")) AS ?manifTitleNode )
  }
  OPTIONAL { ?bfInstance bf:publicationStatement ?pubStmt }
  BIND(
    IF(BOUND(?pubStmt),
       CONCAT(STR(?titleLit), " (", STR(?pubStmt), ")"),
       STR(?titleLit)
    ) AS ?manifLabel
  )
}
