# Pass 1: BFFI Work CONSTRUCT (M3, spec § 3).
#
# Mints raw bffi:Work URIs from the source bf:Work URIs via arq:sha1 (the
# Jena extension function; registered for rdflib in
# bffi_pipeline.uris.register_sparql_functions). Routes Work-only properties
# (PrimaryContribution, subject, classification, originDate, genreForm,
# marcKey, prefLabel) and preserves the Helmet bf:identifiedBy attached at
# M2.
#
# Note vs spec § 3: marc2bibframe2 v3.1.0 emits `bf:PrimaryContribution`
# (not `bflc:PrimaryContribution` as the spec example uses). We match the
# converter's actual output here.

PREFIX bf:        <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:      <http://id.loc.gov/ontologies/bflc/>
PREFIX bffi:      <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX bffi-prov: <http://urn.fi/URN:NBN:fi:schema:bffi-prov#>
PREFIX dct:       <http://purl.org/dc/terms/>
PREFIX madsrdf:   <http://www.loc.gov/mads/rdf/v1#>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX arq:       <http://jena.apache.org/ARQ/function#>

CONSTRUCT {
  ?workURI a bffi:Work ;
           a                        ?workTypeURI ;
           a                        ?workSubclass ;
           a                        ?issuanceWorkSubclass ;
           a                        ?aggregatingWorkSubclass ;
           bffi:hasExpression       ?exprURI ;
           bffi:contribution        ?contrib ;
           bffi:subject             ?subject ;
           bffi:classification      ?class ;
           bffi:originDate          ?originDate ;
           bffi:genreForm           ?workGenre ;
           bffi:musicMedium         ?mediumURI ;
           bffi:intendedAudience    ?audienceURI ;
           bffi:creatorCharacteristic ?creatorCharURI ;
           bffi:originPlace         ?originPlaceURI ;
           bffi:marcKey             ?marcKey ;
           skos:prefLabel           ?workLabel .
  # P-54 Phase 1A — classification inner triples. ``bf:Work
  # → bf:classification → bf:Classification`` carries the
  # classification number (``bf:classificationPortion``) and a
  # source-vocab discriminator (``bf:source → bf:Source → bf:code``)
  # — e.g. "ykl" for MARC 084, "udc" for 080. The round-trip
  # ``_emit_classifications`` walker maps the code to the MARC tag.
  ?class a                          bffi:Classification ;
         bffi:classificationPortion ?classPortion ;
         bf:source                  ?classSource .
  ?classSource a                    bffi:Source ;
               bffi:code            ?classSourceCode .
  # P-50 Phase C — per-record subject reification via W3C-standard
  # ``rdf:Statement``. Each reified statement URI is per-occurrence
  # (one per source 6XX / 655 field), so it carries its own
  # ``bffi-prov:fromMarcField`` token even when the (rdf:object) target
  # URI is shared (YSO / finaf). The flat ``bffi:subject ?subject``
  # triple above is retained as a derived shortcut for Skosmos and
  # other consumers that walk the bare predicate.
  ?subjectStmt a rdf:Statement ;
               rdf:subject       ?workURI ;
               rdf:predicate     bffi:subject ;
               rdf:object        ?subjectStmtTarget ;
               bffi-prov:fromMarcField ?subjectStmtToken .
  ?contrib a               bffi:PrimaryContribution ;
           bffi:agent      ?primaryAgent ;
           bffi:role       ?primaryRole .
  ?primaryAgent rdfs:label   ?primaryAgentLabel ;
                bffi:identifiedBy ?primaryAgentIdent .
  ?primaryAgentIdent a       bffi:Identifier ;
                     rdf:value  ?primaryAgentIdentValue ;
                     bf:source  ?primaryAgentIdentSource .
  ?primaryAgentIdentSource a  bffi:Source ;
                           bffi:code ?primaryAgentIdentSourceCode .
  ?primaryRole  a          bffi:Role ;
                rdfs:label ?primaryRoleLabel .
  # P-36 Phase C: route ``rdfs:label`` for subjects and genreForms.
  # Labels go on ``?bfSubject`` (the source subject node), NOT on
  # ``?subject`` (the COALESCE result). When the cataloguer attached a
  # MADS authority cross-link (madsrdf:isIdentifiedByAuthority), the
  # COALESCE picks the authority URI as ``?subject``, but the
  # cataloguer-supplied label is on the raw bf:Place / bf:Person source
  # node — routing it to ``?subject`` would misattribute the label to
  # the authority URI in our graph. Authority labels stay label-free
  # here so Skosmos can resolve them from Finto at render time.
  ?bfSubject rdfs:label  ?subjectLabel ;
             bflc:marcKey ?subjectMarcKey .
  ?subject a ?bffiSubjectMarcType .
  ?primaryAgent bflc:marcKey ?primaryAgentMarcKey .
  ?workGenre rdfs:label ?workGenreLabel .
  # Music medium (MARC 382): one canonical URI per MediumOfPerformance
  # label, minted locally because marc2bibframe2 leaves the
  # ensemble / mediumComponent / mediumOfPerformance nodes as blank
  # nodes (no #MusicMedium382-N URIs the way 6XX subjects get
  # #Topic650-N / #Place651-N). The hash is SHA-1 of the label so
  # identical labels on the same Work coalesce; the bib:raw record
  # root carries the bib_id prefix.
  ?mediumURI a              bffi:MusicMedium ;
             rdfs:label     ?mediumLabel ;
             bf:source      ?bfMediumSource .
  # MARC 385 (intended audience) → ``bf:intendedAudience`` →
  # ``bf:IntendedAudience`` with ``rdfs:label`` + optional ``bf:source``.
  # Targets at lkd.rdf's ``bffi:IntendedAudience`` class which
  # ``owl:equivalentClass``-es BIBFRAME's bf:IntendedAudience.
  ?audienceURI a            bffi:IntendedAudience ;
               rdfs:label   ?audienceLabel ;
               bf:source    ?bfAudienceSource .
  # MARC 386 (creator characteristic) →
  # ``bflc:creatorCharacteristic`` (note bflc: not bf:) → BFLC
  # CreatorCharacteristic node. Same flatten-and-mint shape.
  ?creatorCharURI a         bffi:CreatorCharacteristic ;
                  rdfs:label    ?creatorCharLabel ;
                  bf:source     ?bfCreatorCharSource .
  # MARC 257 (Country of Producing Entity) — marc2bibframe2 puts
  # ``bf:originPlace`` on the ``bf:Instance``, but lkd.rdf's
  # ``bffi:originPlace`` has ``rdfs:domain bffi:Work``. We hoist the
  # property from the Instance up to the Work to honour the BFFI
  # ontology while still extracting the data marc2bibframe2 produces.
  # Target type is ``bffi:Place`` (the range declared in lkd.rdf).
  ?originPlaceURI a       bffi:Place ;
                  rdfs:label  ?originPlaceLabel ;
                  bf:source   ?bfOriginPlaceSource .
}
WHERE {
  ?bfWork a bf:Work .

  # Skip contained / related Works — those are external references the
  # main Work points at via bf:associatedResource (MARC 700 ind2=2,
  # 740, 776). They lack Helmet identifiers and shouldn't be minted as
  # BFFI Works in this pipeline. Mirrors the SHACL targeting in
  # config/shapes/bibframe-conversion.shape.ttl.
  FILTER NOT EXISTS { ?ref bf:associatedResource ?bfWork }
  FILTER(isIRI(?bfWork))

  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:work:",
            arq:sha1(STR(?bfWork)))) AS ?workURI )
  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:expression:",
            arq:sha1(STR(?bfWork)))) AS ?exprURI )

  # BIBFRAME work-type secondary rdf:type — used by the round-trip
  # converter to pick MARC LDR/06 (type of record). marc2bibframe2
  # emits these alongside ``bf:Work`` to qualify the work content
  # (``bf:Text``, ``bf:MusicAudio``, ``bf:Cartography``, etc).
  # Filtered to the BIBFRAME types LDR/06 routes on; other typing
  # noise (``bf:Hub``, ``bf:Monograph``, ``bf:NotatedMusic`` and
  # related) passes through too when present, which is harmless —
  # the converter's mapping table only acts on routable types.
  OPTIONAL {
    ?bfWork a ?workTypeURI .
    FILTER(?workTypeURI IN (
      bf:Text, bf:NotatedMusic, bf:NotatedMovement, bf:Cartography,
      bf:MovingImage, bf:StillImage, bf:Audio, bf:MusicAudio,
      bf:Multimedia, bf:Object, bf:Dataset, bf:MixedMaterial,
      bf:Manuscript, bf:Tactile
    ))
  }

  # P-52 Phases A + B — Work-axis BFFI subclass typing. Phase A
  # rows are ``owl:equivalentClass`` (semantically identical to the
  # BIBFRAME source class); Phase B rows are ``bffi-meta:broadMatch``
  # (BFFI broadens or narrows the meaning, but the routing intent
  # is clear from the ontology declarations in ``vocab/lkd.rdf``).
  #
  # Phase A — OWL-equivalent (mirror):
  #   - bf:Manuscript  → bffi:Manuscript      (handwritten / typescript content)
  #   - bf:Integrating → bffi:Integrating     (updating resource, e.g. loose-leaf)
  #
  # Phase B — broadMatch (content-shape derived):
  #   - bf:Cartography → bffi:CartographyWork (atlases, maps)
  #   - bf:MovingImage → bffi:MovingImageWork (films, videos)
  #   - bf:MusicAudio  → bffi:MusicWork       (music sound recording)
  #   - bf:NotatedMusic → bffi:MusicWork      (sheet music; same Work, different Expression)
  #   - bf:Audio       → bffi:NonMusicAudioWork (spoken-word recording, environmental sound)
  OPTIONAL {
    ?bfWork a ?bfWorkClass .
    VALUES (?bfWorkClass ?workSubclass) {
      (bf:Manuscript   bffi:Manuscript)
      (bf:Integrating  bffi:Integrating)
      (bf:Cartography  bffi:CartographyWork)
      (bf:MovingImage  bffi:MovingImageWork)
      (bf:MusicAudio   bffi:MusicWork)
      (bf:NotatedMusic bffi:MusicWork)
      (bf:Audio        bffi:NonMusicAudioWork)
    }
  }

  # P-52 Phase C — issuance-derived Work-axis typing. ``bf:issuance``
  # lives on the ``bf:Instance`` (LDR/07 routing); walk the inverse
  # ``bf:instanceOf`` to reach this Work. Two-axis emit: the matching
  # Expression-side typing is in ``bf_to_bffi_expression.rq``. The
  # issuance LoC URIs are stable; we pin the four Helmet sees.
  OPTIONAL {
    ?bfInstanceForIssuance bf:instanceOf ?bfWork ;
                           bf:issuance ?issuanceUri .
    VALUES (?issuanceUri ?issuanceWorkSubclass) {
      (<http://id.loc.gov/vocabulary/issuance/mono>        bffi:MonographWork)
      (<http://id.loc.gov/vocabulary/issuance/serial>      bffi:SerialWork)
      (<http://id.loc.gov/vocabulary/issuance/integrating> bffi:Integrating)
      (<http://id.loc.gov/vocabulary/issuance/collection>  bffi:CollectionWork)
    }
  }

  # P-52 Phase E — Aggregating Work detection. A record is an
  # aggregation when its source ``bf:Work`` has ≥2 outgoing
  # ``bf:relation → bf:associatedResource → bf:Hub`` chains
  # (compilation pattern, dominant 730 / 740 routing) OR carries
  # ``bf:partNumber`` / ``bf:partName`` on the title (multipart
  # designator, 245 ``$n``/``$p``).
  #
  # 15% of the 500-record sample matches one of these triggers
  # (76% compilation, 27% multipart). Typing is additive — an
  # AggregatingWork is also still a MonographWork (issuance) and
  # a MusicWork etc. (content), routed by Phases A-C.
  OPTIONAL {
    FILTER EXISTS {
      ?bfWork bf:relation ?aggRel1 .
      ?aggRel1 bf:associatedResource ?aggHub1 .
      ?aggHub1 a bf:Hub .
      ?bfWork bf:relation ?aggRel2 .
      ?aggRel2 bf:associatedResource ?aggHub2 .
      ?aggHub2 a bf:Hub .
      FILTER(?aggHub1 != ?aggHub2)
    }
    BIND(bffi:AggregatingWork AS ?aggregatingWorkSubclass)
  }
  OPTIONAL {
    FILTER EXISTS {
      ?bfWork bf:title ?aggTitle .
      ?aggTitle bf:partNumber|bf:partName ?aggPart .
    }
    BIND(bffi:AggregatingWork AS ?aggregatingWorkSubclass)
  }

  # Primary creator only (translators, editors -> Expression, see Pass 2).
  # ?contrib must be BIND'ed inside the OPTIONAL so it stays unbound when
  # the source has no bf:PrimaryContribution-with-agent (e.g. a record
  # with only MARC 700 added entries, no 1XX). An inline blank-node
  # template `[ a … ]` would emit one empty [a bffi:PrimaryContribution]
  # bnode per cross-product solution row from the other OPTIONALs below
  # — that's the bug this BIND fixes.
  #
  # ``?primaryAgentLabel`` routes marc2bibframe2's ``<Agent> rdfs:label
  # "Surname, Forename"`` triple through to the BFFI output so M8's
  # ``_primary_contribution_targets`` can extract a label-bearing
  # ContributionTarget and M9 has something to walk. Inner OPTIONAL
  # (label is optional on the agent in principle).
  OPTIONAL {
    ?bfWork bf:contribution ?c .
    ?c a bf:PrimaryContribution ;
       bf:agent ?primaryAgent .
    OPTIONAL { ?primaryAgent rdfs:label ?primaryAgentLabel }
    # ``bflc:marcKey`` on the primary agent — preserves the source
    # 100 $a / $c / $d / $q subfield structure so the round-trip
    # doesn't collapse them into one $a (same fix as for 6XX
    # subjects above).
    OPTIONAL { ?primaryAgent bflc:marcKey ?primaryAgentMarcKey }
    # Route MARC 100 $0 ASTERI / FINAF identifiers — the cataloguer's
    # authority binding via the source-coded ID block
    # ``bf:identifiedBy → bf:Identifier → rdf:value + bf:source →
    # bf:Source → bf:code``. The round-trip converter formats this as
    # ``$0 (FI-ASTERI-N)NNNNNN`` matching the source MARC subfield
    # exactly. The agent label propagates separately above.
    OPTIONAL {
      ?primaryAgent bf:identifiedBy ?primaryAgentIdent .
      ?primaryAgentIdent rdf:value ?primaryAgentIdentValue .
      OPTIONAL {
        ?primaryAgentIdent bf:source ?primaryAgentIdentSource .
        ?primaryAgentIdentSource bf:code ?primaryAgentIdentSourceCode .
      }
    }
    # Route MARC 100 $e (relator term, e.g. "kirjoittaja",
    # "säveltäjä") onto the new BFFI PrimaryContribution. Same
    # blank-node-with-rdfs:label shape as the Expression-side
    # non-primary role routing in bf_to_bffi_expression.rq —
    # the post-M3 relator-term enrichment pass
    # (:mod:`bffi_pipeline.stages.m3.relator_term_enrichment`)
    # looks up the label in the curated MARC-FI ⇆ LoC table and
    # adds a sibling ``bffi:role <relators/CODE>`` URI when
    # matched, so the round-trip converter emits both 100 $4 + $e.
    # marc2bibframe2's input predicate is ``bf:role``; we read it
    # here and re-emit on the CONSTRUCT side as ``bffi:role`` (the
    # BFFI-equivalent property; ``bffi:Contribution`` and the role
    # range ``bffi:Role`` are the matching domain/range pair).
    OPTIONAL {
      ?c bf:role ?primaryRole .
      OPTIONAL { ?primaryRole rdfs:label ?primaryRoleLabel }
    }
    BIND(BNODE() AS ?contrib)
  }
  # P-15: when marc2bibframe2 emits the subject as a bf:Place / bf:Person /
  # bf:Organization / bf:Meeting with a cataloguer-supplied authority URI
  # (MARC $0 → ``madsrdf:isIdentifiedByAuthority <auth-uri>`` on the
  # subject node), prefer the authority URI as the bffi:subject value.
  # Without this, M9 re-reconciles the literal label from scratch and
  # may bind the Swedish form to ``allars`` while the Finnish form binds
  # to ``yso`` (the bilingual-subject bug surfaced by the 2026-05-13
  # cataloguer-audit on b26322791). ``bf:Topic`` (650 topical subjects)
  # already emits the authority URI directly as ``rdf:about``, so the
  # COALESCE is a no-op for the Topic case (?bfSubjectAuth is unbound).
  OPTIONAL {
    ?bfWork bf:subject ?bfSubject .
    OPTIONAL { ?bfSubject madsrdf:isIdentifiedByAuthority ?bfSubjectAuth }
    # ``bflc:marcKey`` on the subject node carries the original
    # subfield structure ("60004$aMikki Hiiri$c(fiktiivinen hahmo)").
    # marc2bibframe2 collapses source $a + $c + $d etc. into a single
    # rdfs:label, so without parsing marcKey the round-trip emits
    # everything as $a — the ``Mikki Hiiri (fiktiivinen hahmo)``
    # concatenation bug.
    OPTIONAL { ?bfSubject bflc:marcKey ?subjectMarcKey }
    # Route the subject's ``rdf:type`` so the round-trip converter
    # can pick MARC 648 (bffi:Temporal), 651 (bffi:Place), 600
    # (bffi:Person), 610 (bffi:Organization), 611 (bffi:Meeting),
    # or 650 (bffi:Topic / default) from typed cataloguer ``$0``
    # URIs that don't carry namespace hints. The ``VALUES`` block
    # also maps each BIBFRAME-side class (as marc2bibframe2 emits
    # it on the source ?bfSubject) to its BFFI-side counterpart so
    # the CONSTRUCT ?subject a ?bffiSubjectMarcType emits the
    # ``bffi:*`` form on the canonical (P-53 Family 1; the BFFI
    # classes are ``owl:equivalentClass`` of their BIBFRAME
    # counterparts per ``vocab/lkd.rdf``). Everything outside this
    # mapping (``madsrdf:Topic`` / ``owl:Thing`` / etc.) is
    # uninteresting noise for the round-trip and stays unbound.
    OPTIONAL {
      VALUES (?subjectMarcType ?bffiSubjectMarcType) {
        (bf:Topic        bffi:Topic)
        (bf:Place        bffi:Place)
        (bf:Temporal     bffi:Temporal)
        (bf:Person       bffi:Person)
        (bf:Organization bffi:Organization)
        (bf:Meeting      bffi:Meeting)
      }
      ?bfSubject a ?subjectMarcType .
    }
    BIND(COALESCE(?bfSubjectAuth, ?bfSubject) AS ?subject)
    # P-36 Phase C: route the cataloguer-supplied label off ?bfSubject
    # (the source node). See CONSTRUCT comment above for the routing
    # decision. Single-triple inner OPTIONAL — same shape as the
    # ?primaryAgent rdfs:label pattern at d040a90, so the rdflib
    # nested-OPTIONAL bug doesn't bite.
    OPTIONAL { ?bfSubject rdfs:label ?subjectLabel }
  }

  # P-50 Phase C — pass M2-post's per-record reified subject
  # statements through to the canonical Work. Each statement URI is
  # per-occurrence and carries the ``bffi-prov:fromMarcField`` token.
  # M2-post emitted the rdf:subject pointing at the raw bf:Work URI;
  # we rewrite it to ``?workURI`` (the canonical work) in the CONSTRUCT
  # above. The flat ``bffi:subject`` triple is retained as a derived
  # shortcut.
  OPTIONAL {
    ?subjectStmt a              rdf:Statement ;
                 rdf:subject    ?bfWork ;
                 rdf:predicate  bffi:subject ;
                 rdf:object     ?subjectStmtTarget ;
                 bffi-prov:fromMarcField ?subjectStmtToken .
  }
  # P-54 Phase 1A — classification chain. marc2bibframe2 emits
  # ``bf:Work → bf:classification → bf:Classification`` with
  # ``bf:classificationPortion <number>`` and ``bf:source → bf:Source
  # → bf:code <vocab>`` (e.g., "ykl" for MARC 084 + $2 ykl, "udc"
  # for 080, "dewey" for 082). Pre-P-54 the CONSTRUCT bound only
  # ``?class`` so the canonical carried an empty bnode under
  # ``bffi:classification``; now we also walk the inner triples so
  # the round-trip ``_emit_classifications`` walker can reconstruct
  # the MARC tag from ``?classSourceCode``. Helmet-local 09X
  # (091/092/093/094/095/097) bypasses marc2bibframe2 entirely
  # because those tags have no ``$2`` — they're handled by a
  # separate M2-post synthesis pass.
  OPTIONAL {
    ?bfWork bf:classification ?class .
    OPTIONAL { ?class bf:classificationPortion ?classPortion }
    OPTIONAL {
      ?class bf:source ?classSource .
      OPTIONAL { ?classSource bf:code ?classSourceCode }
    }
  }
  OPTIONAL { ?bfWork bf:originDate     ?originDate }
  OPTIONAL {
    ?bfWork bf:genreForm ?workGenre .
    # P-36 Phase C: route genreForm label. Same single-triple inner
    # OPTIONAL pattern as the subject case above.
    OPTIONAL { ?workGenre rdfs:label ?workGenreLabel }
  }
  OPTIONAL { ?bfWork bflc:marcKey      ?marcKey }
  OPTIONAL {
    ?bfWork bf:title ?t . ?t bf:mainTitle ?workLabel .
  }
  # MARC 382 → bf:ensemble → bf:mediumComponent → bf:mediumOfPerformance
  # → rdfs:label. marc2bibframe2 emits this as a three-level nested
  # blank-node structure (no fragment URIs minted), so we walk the
  # chain and hoist the reconcilable label onto a flat bffi:musicMedium
  # link. ``$2`` source-vocab tag (e.g. seko, lcmpt) survives on the
  # ``bf:source`` triple so M9's resolver can route by vocab.
  OPTIONAL {
    ?bfWork bf:ensemble ?bfEnsemble .
    ?bfEnsemble bf:mediumComponent ?bfMediumComponent .
    ?bfMediumComponent bf:mediumOfPerformance ?bfMediumOfPerformance .
    ?bfMediumOfPerformance rdfs:label ?mediumLabel .
    OPTIONAL { ?bfMediumOfPerformance bf:source ?bfMediumSource }
    # Mint a local URI for the medium: ``<record-root>#MusicMedium382-<sha1(label)>``.
    # Hashing the label means two 382 fields on the same record with the
    # same label coalesce into one BFFI URI (defensible — they're the
    # same instrument). Different records get different URIs because
    # the record-root prefix carries the bib_id.
    BIND( STRBEFORE(STR(?bfWork), "#") AS ?recordRoot )
    BIND( IRI(CONCAT(?recordRoot,
                     "#MusicMedium382-",
                     arq:sha1(STR(?mediumLabel)))) AS ?mediumURI )
  }
  # MARC 385 (intended audience) — flat ``bf:intendedAudience`` linking
  # to a ``bf:IntendedAudience`` blank node with ``rdfs:label`` + optional
  # ``bf:source``. marc2bibframe2 doesn't mint URI fragments for these,
  # so we mint locally as ``<record-root>#IntendedAudience385-<sha1(label)>``.
  # Reconciles against YSO (age groups like ``"lapset (ikäryhmät)"``
  # are YSO concepts).
  OPTIONAL {
    ?bfWork bf:intendedAudience ?bfAudience .
    ?bfAudience rdfs:label ?audienceLabel .
    OPTIONAL { ?bfAudience bf:source ?bfAudienceSource }
    BIND( STRBEFORE(STR(?bfWork), "#") AS ?audRecordRoot )
    BIND( IRI(CONCAT(?audRecordRoot,
                     "#IntendedAudience385-",
                     arq:sha1(STR(?audienceLabel)))) AS ?audienceURI )
  }
  # MARC 386 (creator characteristic) — note the predicate is
  # ``bflc:creatorCharacteristic`` (BFLC, not BIBFRAME). Same shape as
  # 385: flat link to a CreatorCharacteristic blank node carrying
  # label + optional source. Reconciles against YSO (gender / role
  # concepts like ``"naiset"``).
  OPTIONAL {
    ?bfWork bflc:creatorCharacteristic ?bfCreatorChar .
    ?bfCreatorChar rdfs:label ?creatorCharLabel .
    OPTIONAL { ?bfCreatorChar bf:source ?bfCreatorCharSource }
    BIND( STRBEFORE(STR(?bfWork), "#") AS ?ccRecordRoot )
    BIND( IRI(CONCAT(?ccRecordRoot,
                     "#CreatorCharacteristic386-",
                     arq:sha1(STR(?creatorCharLabel)))) AS ?creatorCharURI )
  }
  # MARC 257 (Country of Producing Entity) — marc2bibframe2 emits
  # ``bf:originPlace`` on the ``bf:Instance`` (not the Work) per the
  # BIBFRAME data model. We walk the inverse ``bf:instanceOf`` link
  # from any Instance pointing AT this Work, grab the originPlace
  # triple, and hoist it onto the BFFI Work — BFFI's ``bffi:originPlace``
  # has ``rdfs:domain bffi:Work``, so this restores the home the BFFI
  # ontology expects. Target is typed ``bffi:Place`` (the range).
  # Reconciles against YSO-paikat at M9 tier-0 with kind=subject.
  OPTIONAL {
    ?bfInstance bf:instanceOf ?bfWork ;
                bf:originPlace ?bfOriginPlace .
    ?bfOriginPlace rdfs:label ?originPlaceLabel .
    OPTIONAL { ?bfOriginPlace bf:source ?bfOriginPlaceSource }
    BIND( STRBEFORE(STR(?bfWork), "#") AS ?opRecordRoot )
    BIND( IRI(CONCAT(?opRecordRoot,
                     "#OriginPlace257-",
                     arq:sha1(STR(?originPlaceLabel)))) AS ?originPlaceURI )
  }

  # P-45 commit 2: Helmet identifier (bf:identifiedBy + dct:identifier)
  # moved from Work to Manifestation (bf_to_bffi_manifestation.rq). A
  # bib_id identifies a published embodiment, not the abstract Work.
  # Discoverable from Work via:
  #   Work → bffi:hasExpression → Expression
  #        ← bffi:expressionManifested ← Manifestation
  #        → bf:identifiedBy / dct:identifier
}
