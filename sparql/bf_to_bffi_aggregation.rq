# Pass 4: BFFI aggregation components CONSTRUCT (P-52 Phase F).
#
# Isolated from ``bf_to_bffi_expression.rq`` because its multi-Hub
# walk (≥1 solution row per source 730 / 700-ind2-2 / 740 chain)
# multiplies bnode-mints in ANY OPTIONAL further out in the
# Expression query, blowing up per-record contribution counts by
# the Hub count (commit a3c6e3 verification showed 25 source
# 700-contributions × 19 source 730-Hubs = 475 ``?otherContrib``
# bnode mints per agent, accumulated across records).
#
# Anchoring the Phase F walk in its own query keeps the parent
# Expression's contribution / variant-title / language OPTIONALs
# at 1:1 cardinality (no cross-product).
#
# Output: for each source ``bf:Work`` that aggregates ≥2 Hubs (the
# Phase E detection rule), emit:
#
#   <parent-expr> bffi:aggregates <component-expr> .
#   <component-expr> a bffi:Expression ;
#                    bffi:aggregatedBy <parent-expr> ;
#                    skos:prefLabel    <Hub label> ;
#                    bflc:marcKey      <Hub marcKey> .
#
# The component-Expression URI is minted from the Hub URI's SHA-1
# (per Hub, not per record — multiple records aggregating the same
# Hub get the same component URI). Phase G.bis's M3 post-pass then
# enriches each component with a ``bffi:contribution → bf:Agent``
# chain extracted from the Hub's marcKey ``$g`` subfield.

PREFIX bf:        <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:      <http://id.loc.gov/ontologies/bflc/>
PREFIX bffi:      <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:      <http://www.w3.org/2004/02/skos/core#>
PREFIX arq:       <http://jena.apache.org/ARQ/function#>

CONSTRUCT {
  ?exprURI bffi:aggregates ?componentExprURI .
  ?componentExprURI a bffi:Expression ;
                    bffi:aggregatedBy ?exprURI ;
                    skos:prefLabel    ?componentLabel ;
                    bflc:marcKey      ?componentMarcKey .
}
WHERE {
  ?bfWork a bf:Work .
  FILTER NOT EXISTS { ?ref bf:associatedResource ?bfWork }
  FILTER(isIRI(?bfWork))

  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:expression:",
            arq:sha1(STR(?bfWork)))) AS ?exprURI )

  # Gate: only emit aggregation edges when the parent Work has ≥2
  # distinct Hubs reachable via ``bf:relation`` (Phase E
  # aggregating-detection rule). Without this, single-Hub records
  # would mint component Expressions whose ``bffi:aggregatedBy``
  # would link a non-AggregatingExpression as parent — violating
  # the predicate's ``rdfs:domain bffi:AggregatingExpression``.
  FILTER EXISTS {
    ?bfWork bf:relation ?_detectRel1 .
    ?_detectRel1 bf:associatedResource ?_detectHub1 .
    ?_detectHub1 a bf:Hub .
    ?bfWork bf:relation ?_detectRel2 .
    ?_detectRel2 bf:associatedResource ?_detectHub2 .
    ?_detectHub2 a bf:Hub .
    FILTER(?_detectHub1 != ?_detectHub2)
  }

  ?bfWork bf:relation ?compRel .
  ?compRel bf:associatedResource ?compHub .
  ?compHub a bf:Hub .
  OPTIONAL { ?compHub rdfs:label ?componentLabel }
  OPTIONAL { ?compHub bflc:marcKey ?componentMarcKey }

  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:expression:",
            arq:sha1(STR(?compHub)))) AS ?componentExprURI )
}
