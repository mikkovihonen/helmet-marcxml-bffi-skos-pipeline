# Pass 2: BFFI Expression CONSTRUCT (M3, spec § 3).
#
# Mints raw bffi:Expression URIs and links them back to the bffi:Work via
# bffi:expressionOf. Routes language-dependent surface (language, content,
# title, summary, note, prefLabel) and any non-primary contributions
# (translator, illustrator, editor). Preserves the Helmet bf:identifiedBy
# from the source bf:Work, matching M2/M3 spec; M8 unions identifiers when
# raw Works merge.
#
# Note vs spec § 3: marc2bibframe2 v3.1.0 emits `bf:PrimaryContribution`
# (not `bflc:PrimaryContribution`). The FILTER NOT EXISTS below tracks
# the converter's actual typing.

PREFIX bf:    <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:  <http://id.loc.gov/ontologies/bflc/>
PREFIX bffi:  <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX arq:   <http://jena.apache.org/ARQ/function#>

CONSTRUCT {
  ?exprURI a bffi:Expression ;
           bffi:expressionOf ?workURI ;
           bffi:uniformTitleHub ?uniformTitleHub ;
           bffi:variantTitle ?variantTitle ;
           bffi:language     ?language ;
           bffi:content      ?contentType ;
           bffi:title        ?title ;
           bffi:contribution ?otherContrib ;
           bffi:summary      ?summary ;
           bffi:note         ?note ;
           skos:prefLabel    ?exprLabel .
  ?otherContrib a bffi:Contribution ;
                bffi:agent ?otherAgent ;
                bf:role    ?otherRole .
  ?otherAgent rdfs:label     ?otherAgentLabel ;
              bf:identifiedBy ?otherAgentIdent ;
              bflc:marcKey    ?otherAgentMarcKey .
  ?otherAgentIdent a         bf:Identifier ;
                   rdf:value ?otherAgentIdentValue ;
                   bf:source ?otherAgentIdentSource .
  ?otherAgentIdentSource a   bf:Source ;
                         bf:code ?otherAgentIdentSourceCode .
  ?otherRole a         bf:Role ;
             rdfs:label ?otherRoleLabel .
  ?contentType rdfs:label ?contentTypeLabel .
  ?uniformTitleHub a bf:Hub ;
                   bflc:marcKey ?uniformTitleMarcKey .
  ?variantTitle a bf:VariantTitle ;
                bf:mainTitle ?variantMainTitle .
}
# P-36 Phase A: bf:role propagation (URI form for cataloguer $4 +
# blank-node-with-rdfs:label form for $e free-text) routes via the
# inner OPTIONAL inside the non-primary contribution block below.
# The d040a90 precedent (?primaryAgent rdfs:label inside the
# PrimaryContribution OPTIONAL) proved the rdflib nested-OPTIONAL
# bug doesn't bite when the inner OPTIONAL is structurally simple.
# The role case wraps two patterns inside the OPTIONAL (the role
# triple + a nested OPTIONAL for the label) — the bug-check fixtures
# (URI form, blank-node-with-label form, three-roles-one-agent form)
# covered by tests/unit/test_bf_to_bffi.py confirmed the binding is
# correct.
WHERE {
  ?bfWork a bf:Work .

  # Skip contained / related Works (see bf_to_bffi_work.rq for rationale).
  FILTER NOT EXISTS { ?ref bf:associatedResource ?bfWork }
  FILTER(isIRI(?bfWork))

  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:work:",
            arq:sha1(STR(?bfWork)))) AS ?workURI )
  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:expression:",
            arq:sha1(STR(?bfWork)))) AS ?exprURI )

  OPTIONAL { ?bfWork bf:language        ?language }
  OPTIONAL {
    ?bfWork bf:content ?contentType .
    # Pass the Finnish source-MARC $a label attached to the URI by
    # marc2bibframe2 through to BFFI so MARC 336 $a round-trips
    # without a LoC contentTypes vocab dump.
    OPTIONAL { ?contentType rdfs:label ?contentTypeLabel }
  }
  OPTIONAL { ?bfWork bf:summary         ?summary }
  OPTIONAL { ?bfWork bf:note            ?note }
  # bf:tableOfContents is intentionally NOT routed here: BFFI's
  # bffi:tableOfContents has rdfs:domain bffi:Manifestation (per
  # docs/lkd.rdf line 3995), not Expression. The pipeline currently
  # doesn't mint Manifestation blocks; preserve that scope by dropping
  # the predicate.

  # Non-primary contributions go here (translator, illustrator, editor).
  # ?otherContrib is BIND'ed inside the OPTIONAL so it stays unbound
  # when no non-primary contribution exists — the same pattern as the
  # primary-contribution OPTIONAL in bf_to_bffi_work.rq.
  #
  # ``?otherAgentLabel`` routes marc2bibframe2's ``<Agent> rdfs:label
  # "..."`` triple through to the BFFI output so M9 can read it on
  # canonical Expressions for non-primary reconciliation. Inner
  # OPTIONAL — label is in principle optional on the agent.
  OPTIONAL {
    ?bfWork bf:contribution ?c .
    FILTER NOT EXISTS { ?c a bf:PrimaryContribution }
    ?c bf:agent ?otherAgent .
    OPTIONAL { ?otherAgent rdfs:label ?otherAgentLabel }
    # ``bflc:marcKey`` on the added-entry agent — preserves the
    # source 700 / 710 / 711 $a / $c / $d / $q / $t subfield
    # structure so the round-trip can split them back out instead of
    # emitting everything as one collapsed $a.
    OPTIONAL { ?otherAgent bflc:marcKey ?otherAgentMarcKey }
    # Route MARC 700/710/711 $0 ASTERI / FINAF identifiers. Source
    # MARC ``$0 (FI-ASTERI-N)NNNNNN`` lands as
    # ``bf:identifiedBy → bf:Identifier → rdf:value + bf:source →
    # bf:Source → bf:code "FI-ASTERI-N"`` on the agent. Mirrors
    # bf_to_bffi_work.rq's primary-agent identifier routing — the
    # round-trip converter reads this chain off the rebuilt
    # canonical Expression's agent and emits ``$0 (code)value``.
    OPTIONAL {
      ?otherAgent bf:identifiedBy ?otherAgentIdent .
      ?otherAgentIdent rdf:value ?otherAgentIdentValue .
      OPTIONAL {
        ?otherAgentIdent bf:source ?otherAgentIdentSource .
        ?otherAgentIdentSource bf:code ?otherAgentIdentSourceCode .
      }
    }
    OPTIONAL {
      ?c bf:role ?otherRole .
      OPTIONAL { ?otherRole rdfs:label ?otherRoleLabel }
    }
    BIND(BNODE() AS ?otherContrib)
  }

  OPTIONAL {
    ?bfWork bf:title ?t . ?t bf:mainTitle ?exprLabel .
    BIND( ?t AS ?title )
  }

  # MARC 240 (uniform title) lands in BIBFRAME as
  # ``bf:Work → bf:expressionOf → bf:Hub (#Hub240-N)``. The Hub
  # carries a ``bflc:marcKey`` with the combined source MARC 1XX +
  # 240 subfield string (e.g.
  # ``1001 $aMorosinotto, Davide$tGrandissimi.$n2,$pLeonardo da Vincei…$lVenäjä``).
  # Round-trip converter parses ``$t``/``$n``/``$p``/``$l`` from
  # marcKey to emit MARC 240 ``$a``/``$n``/``$p``/``$l``.
  OPTIONAL {
    ?bfWork bf:expressionOf ?uniformTitleHub .
    ?uniformTitleHub a bf:Hub .
    OPTIONAL { ?uniformTitleHub bflc:marcKey ?uniformTitleMarcKey }
  }

  # MARC 246 (varying form of title) lands as
  # ``bf:Work → bf:title → bf:VariantTitle → bf:mainTitle``. The
  # ``a bf:VariantTitle`` typing distinguishes it from the main
  # ``bf:Title`` block (which became 245 above). Single ``$a`` for
  # the variant title.
  OPTIONAL {
    ?bfWork bf:title ?variantTitle .
    ?variantTitle a bf:VariantTitle ;
                  bf:mainTitle ?variantMainTitle .
  }

  # P-45 commit 2: Helmet identifier moved from Expression to
  # Manifestation (see bf_to_bffi_manifestation.rq). Discoverable from
  # Expression via the inverse expressionManifested walk.
}
