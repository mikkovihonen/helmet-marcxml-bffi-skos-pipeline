# Pass 2: BFFI Expression CONSTRUCT (M3, spec § 3).
#
# Mints raw bffi:Expression URIs and links them back to the bffi:Work via
# bffi:expressionOf. Routes language-dependent surface (language, content,
# title, summary, note, prefLabel) and any non-primary contributions
# (translator, illustrator, editor). Preserves the Helmet bf:identifiedBy
# from the source bf:Work, matching M2/M3 spec; M8 unions identifiers when
# raw Works merge.
#
# Note vs spec § 3: marc2bibframe2 v3.1.0 emits `bf:PrimaryContribution`
# (not `bflc:PrimaryContribution`). The FILTER NOT EXISTS below tracks
# the converter's actual typing.

PREFIX bf:    <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:  <http://id.loc.gov/ontologies/bflc/>
PREFIX bffi:  <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX arq:   <http://jena.apache.org/ARQ/function#>

CONSTRUCT {
  ?exprURI a bffi:Expression ;
           a                 ?exprSubclass ;
           a                 ?issuanceExprSubclass ;
           a                 ?aggregatingExprSubclass ;
           bffi:expressionOf ?workURI ;
           bffi:title        ?uniformTitleHub ;
           bffi:title        ?variantTitle ;
           bffi:language     ?language ;
           bffi:content      ?contentType ;
           bffi:title        ?title ;
           bffi:contribution ?otherContrib ;
           bffi:summary      ?summary ;
           bffi:note         ?note ;
           skos:prefLabel    ?exprLabel .
  ?note    a               bffi:Note ;
           rdf:type        ?noteType ;
           rdfs:label      ?noteLabel ;
           bffi:language   ?noteLanguage .
  ?otherContrib a bffi:Contribution ;
                bffi:agent ?otherAgent ;
                bffi:role  ?otherRole .
  ?otherAgent rdfs:label     ?otherAgentLabel ;
              bffi:identifiedBy ?otherAgentIdent ;
              bflc:marcKey    ?otherAgentMarcKey .
  ?otherAgentIdent a         bffi:Identifier ;
                   rdf:value ?otherAgentIdentValue ;
                   bf:source ?otherAgentIdentSource .
  ?otherAgentIdentSource a   bffi:Source ;
                         bffi:code ?otherAgentIdentSourceCode .
  ?otherRole a         bffi:Role ;
             rdfs:label ?otherRoleLabel .
  ?contentType rdfs:label ?contentTypeLabel .
  ?uniformTitleHub a bf:Hub ;
                   a ?uniformTitleArrangementType ;
                   bflc:marcKey ?uniformTitleMarcKey ;
                   bffi:title   ?uniformTitleNode ;
                   bf:language  ?uniformTitleLanguage ;
                   bf:musicMedium ?uniformTitleMusicMedium ;
                   bf:keyMode    ?uniformTitleKeyMode ;
                   bffi:version  ?uniformTitleVersion .
  ?uniformTitleLanguage a       bf:Language ;
                        rdfs:label ?uniformTitleLanguageLabel .
  ?uniformTitleMusicMedium a    bf:MusicMedium ;
                           rdfs:label ?uniformTitleMusicMediumLabel .
  ?uniformTitleKeyMode a        bf:KeyMode ;
                       rdfs:label ?uniformTitleKeyModeLabel .
  ?uniformTitleNode a bffi:Title ;
                    bffi:mainTitle  ?uniformMainTitle ;
                    bffi:partNumber ?uniformPartNumber ;
                    bffi:partName   ?uniformPartName .
  ?variantTitle a bf:VariantTitle ;
                bffi:mainTitle ?variantMainTitle .
}
# P-36 Phase A: bffi:role propagation (URI form for cataloguer $4 +
# blank-node-with-rdfs:label form for $e free-text) routes via the
# inner OPTIONAL inside the non-primary contribution block below.
# The d040a90 precedent (?primaryAgent rdfs:label inside the
# PrimaryContribution OPTIONAL) proved the rdflib nested-OPTIONAL
# bug doesn't bite when the inner OPTIONAL is structurally simple.
# The role case wraps two patterns inside the OPTIONAL (the role
# triple + a nested OPTIONAL for the label) — the bug-check fixtures
# (URI form, blank-node-with-label form, three-roles-one-agent form)
# covered by tests/unit/test_bf_to_bffi.py confirmed the binding is
# correct.
WHERE {
  ?bfWork a bf:Work .

  # Skip contained / related Works (see bf_to_bffi_work.rq for rationale).
  FILTER NOT EXISTS { ?ref bf:associatedResource ?bfWork }
  FILTER(isIRI(?bfWork))

  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:work:",
            arq:sha1(STR(?bfWork)))) AS ?workURI )
  BIND( IRI(CONCAT("http://urn.fi/URN:NBN:fi:bib:expression:",
            arq:sha1(STR(?bfWork)))) AS ?exprURI )

  OPTIONAL { ?bfWork bf:language        ?language }

  # P-52 Phases A + B — Expression-axis BFFI subclass typing.
  # marc2bibframe2 emits content-shape secondary types on ``bf:Work``
  # (BIBFRAME has no Expression class; everything piggybacks on Work).
  # BFFI's split puts content / realisation-form classes on the
  # Expression axis, so we mirror each ``bf:Text`` / ``bf:NotatedMusic``
  # / etc. triple onto ``?exprURI`` with its BFFI counterpart.
  #
  # Phase A rows are ``owl:equivalentClass`` (semantically identical);
  # Phase B rows are ``bffi-meta:broadMatch`` (BFFI broadens or narrows
  # the meaning per ``vocab/lkd.rdf``).
  #
  # The existing BIBFRAME-class triple on the bffi:Work is retained
  # for tools expecting it (the work CONSTRUCT carries it).
  OPTIONAL {
    ?bfWork a ?bfExprClass .
    VALUES (?bfExprClass ?exprSubclass) {
      # Phase A — OWL-equivalent (mirror)
      (bf:Text             bffi:Text)
      (bf:NotatedMusic     bffi:NotatedMusic)
      (bf:NotatedMovement  bffi:NotatedMovement)
      (bf:StillImage       bffi:StillImage)
      (bf:Dataset          bffi:Dataset)
      (bf:Object           bffi:Object)
      (bf:MixedMaterial    bffi:MixedMaterial)
      (bf:Multimedia       bffi:Multimedia)
      (bf:Arrangement      bffi:Arrangement)
      # Phase B — broadMatch (content-shape derived realisations)
      (bf:Cartography      bffi:CartographyExpression)
      (bf:MovingImage      bffi:MovingImageExpression)
      (bf:MusicAudio       bffi:MusicAudioExpression)
      (bf:Audio            bffi:NonMusicAudioExpression)
    }
  }

  # P-52 Phase C — issuance-derived Expression-axis typing. Mirrors
  # the Work-axis routing in ``bf_to_bffi_work.rq``. The
  # ``Integrating`` Work has no Expression-side counterpart in BFFI
  # (no ``bffi:IntegratingExpression``), so that row is omitted here.
  OPTIONAL {
    ?bfInstanceForIssuance bf:instanceOf ?bfWork ;
                           bf:issuance ?issuanceUri .
    VALUES (?issuanceUri ?issuanceExprSubclass) {
      (<http://id.loc.gov/vocabulary/issuance/mono>       bffi:MonographExpression)
      (<http://id.loc.gov/vocabulary/issuance/serial>     bffi:SerialExpression)
      (<http://id.loc.gov/vocabulary/issuance/collection> bffi:CollectionExpression)
    }
  }

  # P-52 Phase E — Aggregating Expression typing. Mirrors the
  # ``bffi:AggregatingWork`` detection in ``bf_to_bffi_work.rq``:
  # ≥2 source ``bf:relation → bf:Hub`` chains OR ``bf:partNumber``
  # / ``bf:partName`` on the title.
  OPTIONAL {
    FILTER EXISTS {
      ?bfWork bf:relation ?aggRelE1 .
      ?aggRelE1 bf:associatedResource ?aggHubE1 .
      ?aggHubE1 a bf:Hub .
      ?bfWork bf:relation ?aggRelE2 .
      ?aggRelE2 bf:associatedResource ?aggHubE2 .
      ?aggHubE2 a bf:Hub .
      FILTER(?aggHubE1 != ?aggHubE2)
    }
    BIND(bffi:AggregatingExpression AS ?aggregatingExprSubclass)
  }
  OPTIONAL {
    FILTER EXISTS {
      ?bfWork bf:title ?aggTitleE .
      ?aggTitleE bf:partNumber|bf:partName ?aggPartE .
    }
    BIND(bffi:AggregatingExpression AS ?aggregatingExprSubclass)
  }

  # P-52 Phase F — component-Expression minting was extracted into a
  # separate CONSTRUCT (``bf_to_bffi_aggregation.rq``) so its
  # multi-Hub walk doesn't cross-product with the non-primary
  # contribution / variant-title / other OPTIONALs in this query and
  # blow up per-record bnode-emission counts.

  OPTIONAL {
    ?bfWork bf:content ?contentType .
    # Pass the Finnish source-MARC $a label attached to the URI by
    # marc2bibframe2 through to BFFI so MARC 336 $a round-trips
    # without a LoC contentTypes vocab dump.
    OPTIONAL { ?contentType rdfs:label ?contentTypeLabel }
  }
  OPTIONAL { ?bfWork bf:summary         ?summary }
  # Propagate the note bnode along with its rdfs:label and rdf:type
  # so the Skosify pass + Skosmos rendering can surface the actual
  # note text (MARC 546 $a etc.) instead of a bare ``_:genidN``. The
  # bnode's outgoing triples aren't copied by default — the CONSTRUCT
  # template only emits what it lists.
  OPTIONAL {
    ?bfWork bf:note ?note .
    OPTIONAL { ?note rdfs:label ?noteLabel }
    OPTIONAL {
      ?note rdf:type ?noteType .
      FILTER(?noteType != bf:Note)
    }
    # ``bf:language`` on a note bnode carries the meaning when no
    # ``rdfs:label`` is present (e.g. marc2bibframe2's MARC 041
    # routing produces ``[ a bf:Note, rc:otx ; bf:language <…fre> ]``
    # for "language of the original" notes). Canonicalised to
    # ``bffi:language`` on emit (BFFI closed-namespace discipline —
    # same routing the Expression-level ``bf:language → bffi:language``
    # mirror uses above) so the Skosify
    # ``_synthesise_note_language_labels`` pass can compose a readable
    # prefLabel from the language URI.
    OPTIONAL { ?note bf:language ?noteLanguage }
  }
  # bf:tableOfContents is intentionally NOT routed here: BFFI's
  # bffi:tableOfContents has rdfs:domain bffi:Manifestation (per
  # vocab/lkd.rdf line 3995), not Expression. The pipeline currently
  # doesn't mint Manifestation blocks; preserve that scope by dropping
  # the predicate.

  # Non-primary contributions go here (translator, illustrator, editor).
  # ?otherContrib is BIND'ed inside the OPTIONAL so it stays unbound
  # when no non-primary contribution exists — the same pattern as the
  # primary-contribution OPTIONAL in bf_to_bffi_work.rq.
  #
  # ``?otherAgentLabel`` routes marc2bibframe2's ``<Agent> rdfs:label
  # "..."`` triple through to the BFFI output so M9 can read it on
  # canonical Expressions for non-primary reconciliation. Inner
  # OPTIONAL — label is in principle optional on the agent.
  OPTIONAL {
    ?bfWork bf:contribution ?c .
    FILTER NOT EXISTS { ?c a bf:PrimaryContribution }
    ?c bf:agent ?otherAgent .
    OPTIONAL { ?otherAgent rdfs:label ?otherAgentLabel }
    # ``bflc:marcKey`` on the added-entry agent — preserves the
    # source 700 / 710 / 711 $a / $c / $d / $q / $t subfield
    # structure so the round-trip can split them back out instead of
    # emitting everything as one collapsed $a.
    OPTIONAL { ?otherAgent bflc:marcKey ?otherAgentMarcKey }
    # Route MARC 700/710/711 $0 ASTERI / FINAF identifiers. Source
    # MARC ``$0 (FI-ASTERI-N)NNNNNN`` lands as
    # ``bf:identifiedBy → bf:Identifier → rdf:value + bf:source →
    # bf:Source → bf:code "FI-ASTERI-N"`` on the agent. Mirrors
    # bf_to_bffi_work.rq's primary-agent identifier routing — the
    # round-trip converter reads this chain off the rebuilt
    # canonical Expression's agent and emits ``$0 (code)value``.
    OPTIONAL {
      ?otherAgent bf:identifiedBy ?otherAgentIdent .
      ?otherAgentIdent rdf:value ?otherAgentIdentValue .
      OPTIONAL {
        ?otherAgentIdent bf:source ?otherAgentIdentSource .
        ?otherAgentIdentSource bf:code ?otherAgentIdentSourceCode .
      }
    }
    OPTIONAL {
      ?c bf:role ?otherRole .
      OPTIONAL { ?otherRole rdfs:label ?otherRoleLabel }
    }
    BIND(BNODE() AS ?otherContrib)
  }

  OPTIONAL {
    ?bfWork bf:title ?t . ?t bf:mainTitle ?exprLabel .
    BIND( ?t AS ?title )
  }

  # MARC 240 (uniform title) lands in BIBFRAME as
  # ``bf:Work → bf:expressionOf → bf:Hub (#Hub240-N)``. The Hub
  # carries:
  #
  #   - ``bflc:marcKey`` with the combined source MARC 1XX + 240
  #     subfield string (e.g.
  #     ``1001 $aMorosinotto, Davide$tGrandissimi.$n2,$pLeonardo…$lVenäjä``).
  #     Last-resort source for $l (title language) — P-49 Layer 3 gap.
  #
  #   - structured ``bf:title → bf:Title`` with ``bf:mainTitle``
  #     (concatenated form, including part info), ``bf:partNumber``,
  #     and ``bf:partName``. P-49 Layer 1: prefer these for $n and $p
  #     so the round-trip converter no longer needs to parse marcKey
  #     for those subfields.
  OPTIONAL {
    ?bfWork bf:expressionOf ?uniformTitleHub .
    ?uniformTitleHub a bf:Hub .
    OPTIONAL { ?uniformTitleHub bflc:marcKey ?uniformTitleMarcKey }
    OPTIONAL {
      ?uniformTitleHub bf:title ?uniformTitleNode .
      ?uniformTitleNode a bf:Title ;
                        bf:mainTitle ?uniformMainTitle .
      OPTIONAL { ?uniformTitleNode bf:partNumber ?uniformPartNumber }
      OPTIONAL { ?uniformTitleNode bf:partName   ?uniformPartName }
    }
    # P-168 — route MARC 240 ``$l`` from the Hub's BIBFRAME
    # ``bf:language → bf:Language → rdfs:label`` chain. Without this
    # the converter falls back to parsing marcKey for ``$l``; with
    # it the row stays BFFI-native (no ``marckey_bypass`` flag).
    OPTIONAL {
      ?uniformTitleHub bf:language ?uniformTitleLanguage .
      ?uniformTitleLanguage a bf:Language ;
                            rdfs:label ?uniformTitleLanguageLabel .
    }
    # MARC 240 ``$m`` — music medium of performance. marc2bibframe2's
    # ConvSpec-240andX30-UnifTitle.xsl emits
    # ``bf:musicMedium → bf:MusicMedium → rdfs:label``. BFFI 1.0.0
    # declares ``bffi:musicMedium owl:equivalentProperty bf:musicMedium``
    # and ``bffi:MusicMedium owl:equivalentClass bf:MusicMedium``; we
    # keep the BIBFRAME shape on canonical so the round-trip reader can
    # mirror marc2bibframe2's emit directly.
    OPTIONAL {
      ?uniformTitleHub bf:musicMedium ?uniformTitleMusicMedium .
      ?uniformTitleMusicMedium a bf:MusicMedium ;
                               rdfs:label ?uniformTitleMusicMediumLabel .
    }
    # MARC 240 ``$r`` — music key. marc2bibframe2 v3.1+ emits the
    # structured ``bf:keyMode → bf:KeyMode → rdfs:label`` (NOT the
    # older flat ``bf:musicKey`` literal). lkd.rdf has ``bffi:musicKey``
    # (alias of ``bf:musicKey``, literal range) but NO ``bffi:keyMode``,
    # so we emit ``bf:keyMode`` directly per the project's BFFI namespace
    # discipline (BIBFRAME term reuse when no BFFI alias exists).
    OPTIONAL {
      ?uniformTitleHub bf:keyMode ?uniformTitleKeyMode .
      ?uniformTitleKeyMode a bf:KeyMode ;
                           rdfs:label ?uniformTitleKeyModeLabel .
    }
    # MARC 240 ``$s`` — version statement. marc2bibframe2 emits as a
    # plain literal on the Hub; BFFI alias ``bffi:version``.
    OPTIONAL { ?uniformTitleHub bf:version ?uniformTitleVersion }
    # MARC 240 ``$o`` — arrangement. marc2bibframe2 emits the
    # existence marker as ``rdf:type bf:Arrangement`` on the Hub (the
    # literal ``$o`` text is lost at the BIBFRAME boundary — see
    # docs/bffi_limitations.md L-13). Pass the type marker through so
    # downstream consumers can detect arrangements without parsing
    # marcKey; the round-trip still uses marcKey for the literal text.
    OPTIONAL {
      ?uniformTitleHub a ?uniformTitleArrangementType .
      FILTER(?uniformTitleArrangementType = bf:Arrangement)
    }
  }

  # MARC 246 (varying form of title) lands as
  # ``bf:Work → bf:title → bf:VariantTitle → bf:mainTitle``. The
  # ``a bf:VariantTitle`` typing distinguishes it from the main
  # ``bf:Title`` block (which became 245 above). Single ``$a`` for
  # the variant title.
  OPTIONAL {
    ?bfWork bf:title ?variantTitle .
    ?variantTitle a bf:VariantTitle ;
                  bf:mainTitle ?variantMainTitle .
  }

  # P-45 commit 2: Helmet identifier moved from Expression to
  # Manifestation (see bf_to_bffi_manifestation.rq). Discoverable from
  # Expression via the inverse expressionManifested walk.
}
