loc:ne  skos:exactMatch yso:p105190 ;
        skos:prefLabel  "Alankomaat"@fi, "Nederländerna"@sv, "Netherlands"@en ;
        skos:notation   "ne" .

loc:ru  skos:exactMatch yso:p94479 ;
        skos:prefLabel  "Venäjä"@fi, "Ryssland"@sv, "Russia"@en ;
        skos:notation   "ru" .

loc:si  skos:exactMatch yso:p105234 ;
        skos:prefLabel  "Singapore"@fi, "Singapore"@sv, "Singapore"@en ;
