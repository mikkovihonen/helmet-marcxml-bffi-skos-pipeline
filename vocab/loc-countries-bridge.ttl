loc:xxk skos:exactMatch yso:p107128 ;
        skos:prefLabel  "Englanti"@fi, "England"@sv, "England"@en ;
        skos:notation   "xxk" ;
        rdfs:comment    "LoC MARC `xxk` denotes England specifically; the broader 'United Kingdom' concept is yso:p104990 (Iso-Britannia). We bridge to England here because that's the MARC code's literal meaning."@en .

loc:xxu skos:exactMatch yso:p105078 ;
        skos:prefLabel  "Yhdysvallat"@fi, "Förenta staterna"@sv, "United States"@en ;
        skos:notation   "xxu" .

# Codes observed in the 500-sample whose meaning needs verification
# against the LoC MARC country code list before we can bridge them:
#
# - aa : not in the official LoC MARC country code list — likely a
#        data-entry typo or pre-1980 obsolete code. Skip until we
#        identify the actual country it was meant for.
# - un : appears in the LoC MARC code list (per
#        https://www.loc.gov/marc/countries/) but its mapping is
#        ambiguous (possibly pre-1991 Ukraine; possibly USSR-era).
#        Skip until verified against a sample record.
# - xx : LoC sentinel "no place, unknown, or undetermined" — no
#        country bridge appropriate; downstream consumers should
#        handle the URI as opaque.

