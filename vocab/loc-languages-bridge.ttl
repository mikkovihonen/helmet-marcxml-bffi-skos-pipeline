# === Codes without a YSO concept (project-supplied labels) ===
#
# `cos` (Corsican) — YSO has "Korsika" (the island, p108087) but no
# Corsican-language concept; project supplies the label.
# `pan` (Panjabi) — YSO has "punjabit" (the people, p38213) but no
# distinct Panjabi-language concept.
# `mul` / `und` / `zxx` — MARC sentinels for "multiple languages",
# "undetermined", "no linguistic content" respectively. Skosmos
# needs prefLabels so cataloguers can read them.

loc:cos  skos:prefLabel  "korsikan kieli"@fi,
                         "korsikanska"@sv,
                         "Corsican language"@en ;
         skos:notation   "cos" .

loc:pan  skos:prefLabel  "panjabin kieli"@fi,
                         "panjabi"@sv,
                         "Panjabi language"@en ;
         skos:notation   "pan" .

loc:mul  skos:prefLabel  "useita kieliä"@fi,
                         "flera språk"@sv,
                         "Multiple languages"@en ;
         skos:notation   "mul" .

loc:und  skos:prefLabel  "kielimäärittelemätön"@fi,
                         "obestämt språk"@sv,
                         "Undetermined language"@en ;
         skos:notation   "und" .

loc:zxx  skos:prefLabel  "ei kielellistä sisältöä"@fi,
                         "inget språkligt innehåll"@sv,
                         "No linguistic content"@en ;
         skos:notation   "zxx" .

