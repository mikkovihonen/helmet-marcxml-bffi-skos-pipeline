# Boundary 5 post-load smoke tests (M10).
#
# Run all four ASK queries against Fuseki immediately after a load. ALL
# must return true. Any failure rolls back: drop the bffi-works graph
# and exit non-zero. Never leave Fuseki in a half-loaded state.
#
# Queries are separated by `# === <name> ===` headers; the loader splits
# on those markers and runs each query as a separate HTTP request.

# === Skosify dual-typing ===
PREFIX bffi: <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ASK {
    ?w a bffi:Work, skos:Concept ;
       skos:prefLabel ?l .
}

# === Expressions linked to Works ===
PREFIX bffi: <http://urn.fi/URN:NBN:fi:schema:bffi:>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ASK {
    ?e a bffi:Expression, skos:Concept ;
       bffi:expressionOf ?w .
}

# === Helmet identifiers reachable from canonical Works via Manifestation ===
PREFIX bf:   <http://id.loc.gov/ontologies/bibframe/>
PREFIX bffi: <http://urn.fi/URN:NBN:fi:schema:bffi:>

# P-45 commit 2: bf:identifiedBy moved from canonical Work onto
# Manifestation (each Manifestation is 1:1 with one Helmet bib record).
# This ASK pins the new invariant AND the Work → Expression ← Manifestation
# walk that lets cataloguer tooling rediscover the bib_id from a Work:
#   Work --bffi:hasExpression--> Expression
#        <--bffi:expressionManifested-- Manifestation
#        --bf:identifiedBy--> Helmet-sourced identifier
ASK {
    ?w a bffi:Work ;
       bffi:hasExpression ?e .
    ?m a bffi:Manifestation ;
       bffi:expressionManifested ?e ;
       bf:identifiedBy [
           bf:source <http://urn.fi/URN:NBN:fi:bib:source:helmet>
       ] .
}

# === Skosify-inferred SKOS inverses (narrower/broader) ===
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ASK {
    ?w skos:narrower ?e .
    ?e skos:broader  ?w .
}
