# config/overlay/bffi-skos-overlay.ttl
#
# Skosify overlay file. Loaded *alongside* the canonical BFFI Turtle
# (M8 output) so the Skosify RDFS-inference pass dual-types every
# bffi:Work / bffi:Expression as skos:Concept and lifts
# bffi:hasExpression / bffi:expressionOf to skos:narrower / skos:broader,
# WITHOUT destroying the BFFI types.
#
# Companion to docs/marcxml-to-bffi-skosmos-pipeline.md § 5
# ("overlay-plus-inference"). The destructive Skosify [types] mappings
# would force conversion updates every time BFFI evolves; the overlay
# approach absorbs new BFFI subclasses with a one-line addition here.

@prefix bf:   <http://id.loc.gov/ontologies/bibframe/> .
@prefix bffi: <http://urn.fi/URN:NBN:fi:schema:bffi:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ---------------------------------------------------------------------------
# BFFI classes ⊑ skos:Concept — Skosify's RDFS pass adds the
# rdf:type skos:Concept on every instance, but the bffi:Work /
# bffi:Expression typing remains.
# ---------------------------------------------------------------------------

bffi:Work          rdfs:subClassOf skos:Concept ;
                   rdfs:label "Work"@en, "Teos"@fi, "Verk"@sv .

bffi:Expression    rdfs:subClassOf skos:Concept ;
                   rdfs:label "Expression"@en, "Ekspressio"@fi, "Uttryck"@sv .

bffi:Manifestation rdfs:subClassOf skos:Concept ;
                   rdfs:label "Manifestation"@en, "Manifestaatio"@fi, "Manifestation"@sv .

# ---------------------------------------------------------------------------
# Hierarchical relations ⊑ SKOS — the Skosmos hierarchy view follows
# skos:narrower / skos:broader, so M10 needs Works to expose Expressions
# under skos:narrower in addition to bffi:hasExpression.
# ---------------------------------------------------------------------------

bffi:hasExpression rdfs:subPropertyOf skos:narrower ;
                   rdfs:label "has expression"@en, "ekspressio"@fi, "uttryck"@sv .

bffi:expressionOf  rdfs:subPropertyOf skos:broader ;
                   rdfs:label "expression of"@en, "ekspressio teoksesta"@fi,
                              "uttryck för verk"@sv .

# Manifestation-side links (P-45). Labels MUST be declared here or
# Skosmos drops the rows from the rendered concept page — the BFFI
# ontology's lkd.rdf labels aren't loaded into the bffi-works graph,
# only the overlay is. Subproperty lifting to skos:narrower /
# skos:broader makes Manifestations appear under their Expression in
# the Skosmos hierarchy view (the Expression page's left-rail tree
# expands to show its Manifestations).
bffi:manifestationOfExpression rdfs:subPropertyOf skos:narrower ;
                               rdfs:label "manifestation of expression"@en,
                                          "manifestaatio"@fi,
                                          "manifestation"@sv .

bffi:expressionManifested      rdfs:subPropertyOf skos:broader ;
                               rdfs:label "expression manifested"@en,
                                          "manifestoitu ekspressio"@fi,
                                          "uttryck"@sv .

# RDA Media + Carrier types live on the Manifestation. The URIs point
# at LoC's vocabularies (loaded by ``load-finto`` into Fuseki under
# their own named graphs), so Skosmos resolves them to clickable
# concept pages under :rda-media / :rda-carrier once the overlay
# declares an rdfs:label that opens the row in the Twig template.
bffi:media   rdfs:label "Media type"@en, "Mediatyyppi"@fi, "Medietyp"@sv .
bffi:carrier rdfs:label "Carrier type"@en, "Tallennetyyppi"@fi, "Bärartyp"@sv .

# MARC 007-derived format details on each Manifestation. The
# ``bf:digitalCharacteristic`` predicate distinguishes DVD from
# Blu-ray (LoC mencformat); ``bf:soundCharacteristic`` carries the
# audio facets — recording medium, playback speed, channels, capture
# technique (LoC mrecmedium / mplayspeed / mplayback /
# mcapturestorage). All forwarded onto BFFI by M3.
bffi:digitalCharacteristic rdfs:label "Digital format"@en,
                                      "Digitaalinen tallennusmuoto"@fi,
                                      "Digital format"@sv .
bffi:soundCharacteristic   rdfs:label "Sound characteristic"@en,
                                      "Äänen ominaisuudet"@fi,
                                      "Ljudegenskap"@sv .
bffi:colorContent          rdfs:label "Color content"@en,
                                      "Värisisältö"@fi,
                                      "Färginnehåll"@sv .

# Not surfacing ``prov:wasDerivedFrom`` on the Skosmos Work page:
# the predicate points at the raw Work URI absorbed by M8's union-find,
# but those raw URIs have no triples of their own (the data was
# collapsed into the canonical), so the row rendered as a broken link.
# The same provenance information is reachable from the cataloguer's
# point of view via the Work → Expression → Manifestation drill-down
# (each Manifestation carries the absorbed bib_id + title + format
# details), so the row is redundant. The triple stays in canonical.ttl
# unchanged for forensic SPARQL queries.

# ---------------------------------------------------------------------------
# Reconciliation predicates surfaced as concept-page properties.
#
# Skosmos only renders predicates it has an rdfs:label for. M9 reconciles
# canonical-Work creators / subjects / genre-forms onto Finto authority
# URIs (KANTO/YSO/KAUNO/MUSO/SLM), and option 3b loads those vocabs into
# our local Fuseki so Skosmos's vocabulary registry can resolve the URIs
# to clickable, labelled links. The labels below are what Skosmos shows
# as the section heading on each canonical-Work concept page.
# ---------------------------------------------------------------------------

bffi:subject   rdfs:label "Subject"@en, "Aihe"@fi, "Ämne"@sv .
bffi:genreForm rdfs:label "Genre/form"@en, "Genre/muoto"@fi, "Genre/form"@sv .

# Primary creator + non-primary contributor are emitted as flat
# ``dct:creator`` / ``dct:contributor`` triples on each Work / Expression
# in M8 so Skosmos renders them directly under the labelled section.
# Skosmos shows only outgoing properties on a subject's page and doesn't
# traverse the blank-node ``bffi:contribution`` chain that's the BFFI
# 1.0.0 structural model — the flat predicates are the display layer.
dct:creator     rdfs:label "Creator"@en, "Tekijä"@fi, "Upphovsperson"@sv .
dct:contributor rdfs:label "Contributor"@en, "Muu tekijä"@fi, "Medverkande"@sv .

# bffi:role labels the role URI on each Contribution block (the
# BFFI-equivalent of bf:role, owl:equivalentProperty in lkd.rdf;
# the project uses bffi:role throughout the canonical graph since
# bffi:Role's range-of-values comes from MTS — see the
# bffi-meta:relatedValueVocabulary pointers on lkd.rdf's bffi:Role
# class to the four MTS axis-collections m34/m153/m491/m1157).
# Without this rdfs:label Skosmos drops the predicate from the
# rendered concept page.
bffi:role rdfs:label "Role"@en, "Rooli"@fi, "Roll"@sv .

# ---------------------------------------------------------------------------
# Helmet source URI — declared as a real entity so bf:identifiedBy
# triples on Works and Expressions resolve to a labeled resource in
# Skosmos rather than a dangling URI.
#
# Helmet is the joint catalog of the public libraries of Helsinki,
# Espoo, Vantaa, and Kauniainen. The underlying ILS is Sierra, but
# that is implementation detail and is NOT preserved in the data —
# provenance attributes records to Helmet, not Sierra.
#
# The source is dual-typed bf:Source + bffi:Source per spec § 5 and
# `docs/lkd.rdf` line 609 (`bffi:Source` is `owl:equivalentClass` of
# `bf:Source`); BFFI-native consumers and BIBFRAME consumers both see
# a typed entity.
# ---------------------------------------------------------------------------

<http://urn.fi/URN:NBN:fi:bib:source:helmet>
    a            bf:Source, bffi:Source ;
    rdfs:label   "Helmet"@en, "Helmet"@fi, "Helmet"@sv ;
    bf:code      "helmet-bib" ;
    rdfs:comment "Joint catalog of the public libraries of Helsinki, Espoo, Vantaa, and Kauniainen. Underlying ILS is Sierra; this is implementation detail and not preserved in the data."@en ,
                 "Helsingin, Espoon, Vantaan ja Kauniaisten kunnankirjastojen yhteinen aineistorekisteri."@fi .

# ---------------------------------------------------------------------------
# `dct:identifier` is denormalised onto every Work / Expression in M3
# post-processing as a Sierra-style bib number (e.g. "b100000010"). The
# rdfs:label here is what Skosmos renders as the property heading on the
# concept page; without it cataloguers see the bare predicate URI. The
# bib-number form itself is what they paste into Sierra discussions.
# ---------------------------------------------------------------------------

dct:identifier rdfs:label "Helmet bib ID"@en,
                          "Helmet-tunniste"@fi,
                          "Helmet-bib-id"@sv .

# ---------------------------------------------------------------------------
# P-52 BFFI subclass typing (Phase A–F): every subclass we emit needs an
# rdfs:label so the Skosmos type sidebar surfaces it with a human-readable
# name instead of the bare URI. Source labels come from ``docs/lkd.rdf``;
# we re-state them here so the overlay stays self-contained.
# ---------------------------------------------------------------------------

# Work-axis subclasses
bffi:MonographWork         rdfs:label "Monograph work"@en,
                                      "Monografiateos"@fi,
                                      "Monografiverk"@sv .
bffi:SerialWork            rdfs:label "Serial work"@en,
                                      "Sarjajulkaisuteos"@fi,
                                      "Periodiskt verk"@sv .
bffi:CollectionWork        rdfs:label "Collection work"@en,
                                      "Kokoelmateos"@fi,
                                      "Samlingsverk"@sv .
bffi:Integrating           rdfs:label "Integrating work"@en,
                                      "Päivittyvä teos"@fi,
                                      "Integrerande verk"@sv .
bffi:Manuscript            rdfs:label "Manuscript"@en,
                                      "Käsikirjoitus"@fi,
                                      "Manuskript"@sv .
bffi:CartographyWork       rdfs:label "Cartographic work"@en,
                                      "Kartografinen teos"@fi,
                                      "Kartografiskt verk"@sv .
bffi:MovingImageWork       rdfs:label "Moving image work"@en,
                                      "Liikkuvan kuvan teos"@fi,
                                      "Rörlig bild-verk"@sv .
bffi:MusicWork             rdfs:label "Music work"@en,
                                      "Musiikkiteos"@fi,
                                      "Musikverk"@sv .
bffi:NonMusicAudioWork     rdfs:label "Non-music audio work"@en,
                                      "Ei-musikaalinen ääniteos"@fi,
                                      "Ej-musikaliskt ljudverk"@sv .
bffi:SeriesWork            rdfs:label "Series work"@en,
                                      "Sarjateos"@fi,
                                      "Serieverk"@sv .
bffi:AggregatingWork       rdfs:label "Aggregating work"@en,
                                      "Aggregoiva teos"@fi,
                                      "Aggregerande verk"@sv .

# Expression-axis subclasses
bffi:Text                  rdfs:label "Text"@en, "Teksti"@fi, "Text"@sv .
bffi:NotatedMusic          rdfs:label "Notated music"@en,
                                      "Notatoitu musiikki"@fi,
                                      "Noterad musik"@sv .
bffi:NotatedMovement       rdfs:label "Notated movement"@en,
                                      "Notatoitu liikenotaatio"@fi,
                                      "Noterad rörelse"@sv .
bffi:StillImage            rdfs:label "Still image"@en,
                                      "Pysäytetty kuva"@fi,
                                      "Stillbild"@sv .
bffi:Dataset               rdfs:label "Dataset"@en, "Aineisto"@fi, "Datamängd"@sv .
bffi:Object                rdfs:label "Three-dimensional form"@en,
                                      "Kolmiulotteinen muoto"@fi,
                                      "Tredimensionell form"@sv .
bffi:MixedMaterial         rdfs:label "Mixed material"@en,
                                      "Sekamateriaali"@fi,
                                      "Blandat material"@sv .
bffi:Multimedia            rdfs:label "Software"@en,
                                      "Ohjelmisto"@fi,
                                      "Programvara"@sv .
bffi:Arrangement           rdfs:label "Arrangement"@en,
                                      "Sovitus"@fi,
                                      "Arrangemang"@sv .
bffi:CartographyExpression rdfs:label "Cartographic expression"@en,
                                      "Kartografinen ekspressio"@fi,
                                      "Kartografiskt uttryck"@sv .
bffi:MovingImageExpression rdfs:label "Moving image expression"@en,
                                      "Liikkuvan kuvan ekspressio"@fi,
                                      "Rörlig bild-uttryck"@sv .
bffi:MusicAudioExpression  rdfs:label "Music audio expression"@en,
                                      "Musiikkitallenne-ekspressio"@fi,
                                      "Musikljud-uttryck"@sv .
bffi:NonMusicAudioExpression rdfs:label "Non-music audio expression"@en,
                                        "Ei-musikaalinen ääni-ekspressio"@fi,
                                        "Ej-musikaliskt ljud-uttryck"@sv .
bffi:MonographExpression   rdfs:label "Monograph expression"@en,
                                      "Monografia-ekspressio"@fi,
                                      "Monografi-uttryck"@sv .
bffi:SerialExpression      rdfs:label "Serial expression"@en,
                                      "Sarjajulkaisu-ekspressio"@fi,
                                      "Periodiskt uttryck"@sv .
bffi:CollectionExpression  rdfs:label "Collection expression"@en,
                                      "Kokoelma-ekspressio"@fi,
                                      "Samlings-uttryck"@sv .
bffi:SeriesExpression      rdfs:label "Series expression"@en,
                                      "Sarja-ekspressio"@fi,
                                      "Serie-uttryck"@sv .
bffi:AggregatingExpression rdfs:label "Aggregating expression"@en,
                                      "Aggregoiva ekspressio"@fi,
                                      "Aggregerande uttryck"@sv .

# Manifestation-axis subclasses
bffi:Print                 rdfs:label "Printed"@en, "Painettu"@fi, "Tryckt"@sv .
bffi:Electronic            rdfs:label "Electronic"@en, "Elektroninen"@fi, "Elektronisk"@sv .
bffi:Microform             rdfs:label "Microform"@en, "Mikromuoto"@fi, "Mikroform"@sv .
bffi:Tactile               rdfs:label "Tactile material"@en,
                                      "Tuntoaistiin perustuva aineisto"@fi,
                                      "Taktilt material"@sv .
bffi:Archival              rdfs:label "Archival controlled"@en,
                                      "Arkistokäytänne"@fi,
                                      "Arkivkontrollerad"@sv .
bffi:CollectionManifestation rdfs:label "Collection instance"@en,
                                        "Kokoelmainstanssi"@fi,
                                        "Samlingsinstans"@sv .

# ---------------------------------------------------------------------------
# Predicates emitted on Works / Expressions / Manifestations in canonical.ttl
# but previously unlabeled — Skosmos drops any predicate without an rdfs:label
# from rendered concept pages. These labels make the data visible.
# ---------------------------------------------------------------------------

# Work / Expression / Manifestation structural chains (rendered as outgoing
# links; Skosmos walks one hop only — the per-blank-node sub-content is
# surfaced by the Skosify-stage flatteners that emit flat companion
# predicates listed further below).
bffi:contribution      rdfs:label "Contribution"@en,
                                  "Tekijyys"@fi,
                                  "Medverkan"@sv .
bffi:title             rdfs:label "Title"@en, "Nimeke"@fi, "Titel"@sv .
bffi:language          rdfs:label "Language"@en, "Kieli"@fi, "Språk"@sv .
bffi:content           rdfs:label "Content type"@en,
                                  "Sisältötyyppi"@fi,
                                  "Innehållstyp"@sv .
bffi:note              rdfs:label "Note"@en, "Huomautus"@fi, "Anmärkning"@sv .
bffi:summary           rdfs:label "Summary"@en, "Tiivistelmä"@fi, "Sammandrag"@sv .
bffi:adminMetadata     rdfs:label "Administrative metadata"@en,
                                  "Hallinnolliset metatiedot"@fi,
                                  "Administrativ metadata"@sv .
bffi:provisionActivity rdfs:label "Provision activity"@en,
                                  "Saatavuustieto"@fi,
                                  "Tillgänglighetsuppgift"@sv .
bffi:publicationStatement rdfs:label "Publication statement"@en,
                                     "Julkaisutiedot"@fi,
                                     "Publiceringsuppgift"@sv .
bffi:relation          rdfs:label "Related resource"@en,
                                  "Liittyvä resurssi"@fi,
                                  "Relaterad resurs"@sv .
bffi:responsibilityStatement rdfs:label "Statement of responsibility"@en,
                                        "Vastuullisuustiedot"@fi,
                                        "Ansvarsuppgift"@sv .
bffi:extent            rdfs:label "Extent"@en, "Laajuus"@fi, "Omfång"@sv .
bffi:dimensions        rdfs:label "Dimensions"@en, "Mitat"@fi, "Dimensioner"@sv .
bf:hasSeries           rdfs:label "Is part of series"@en,
                                  "Osa sarjaa"@fi,
                                  "Del av serie"@sv .
bffi:tableOfContents   rdfs:label "Table of contents"@en,
                                  "Sisällysluettelo"@fi,
                                  "Innehållsförteckning"@sv .
bffi:editionStatement  rdfs:label "Edition"@en, "Painos"@fi, "Upplaga"@sv .
bf:issuance            rdfs:label "Issuance"@en, "Ilmestyminen"@fi, "Utgivning"@sv .
bf:identifiedBy        rdfs:label "Identifier"@en,
                                  "Tunniste"@fi,
                                  "Identifierare"@sv .
bffi:aggregates        rdfs:label "Aggregates"@en,
                                  "Sisältää osan"@fi,
                                  "Innehåller del"@sv .
bffi:aggregatedBy      rdfs:label "Part of"@en,
                                  "Sisältyy kokoelmaan"@fi,
                                  "Del av samling"@sv .

# ---------------------------------------------------------------------------
# Display-only flat predicates synthesised by the Skosify stage's
# _synthesise_display_predicates family (m10/skosify_run.py). These live
# ONLY in canonical-skosified.ttl — the canonical.ttl that NLF could
# ingest carries only the structural BFFI chains above.
# ---------------------------------------------------------------------------

dct:publisher   rdfs:label "Publisher"@en, "Julkaisija"@fi, "Förlag"@sv .
dct:date        rdfs:label "Date"@en, "Vuosi"@fi, "År"@sv .
dct:spatial     rdfs:label "Place"@en, "Paikka"@fi, "Plats"@sv .
dct:isPartOf    rdfs:label "Series"@en, "Sarja"@fi, "Serie"@sv .
dct:modified    rdfs:label "Last modified"@en,
                           "Viimeksi muokattu"@fi,
                           "Senast ändrad"@sv .
dct:conformsTo  rdfs:label "Cataloguing convention"@en,
                           "Luettelointikäytäntö"@fi,
                           "Katalogiseringspraxis"@sv .
bf:isbn         rdfs:label "ISBN"@en, "ISBN"@fi, "ISBN"@sv .
bf:audioIssueNumber rdfs:label "Audio issue number"@en,
                               "Äänitalon numero"@fi,
                               "Ljudutgåvanummer"@sv .
bf:systemNumber rdfs:label "System control number"@en,
                           "Järjestelmän kontrollinumero"@fi,
                           "Systemkontrollnummer"@sv .
