# config/skosmos-config.ttl
#
# Skosmos vocabulary configuration for the BFFI authority graph
# (M11). Mounted into the Skosmos container at /var/www/html/config.ttl
# by docker-compose.yml. Companion to
# docs/marcxml-to-bffi-skosmos-pipeline.md § 4.
#
# Note on hostnames: this file lives INSIDE the Skosmos container, so
# the SPARQL endpoint URL uses the docker-compose service name
# `fuseki` rather than `localhost`. A user running Skosmos directly
# on the host (no Docker) should swap `http://fuseki:3030/...` for
# `http://localhost:3030/...` here.

@prefix skosmos: <http://purl.org/net/skosmos#> .
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix dc:      <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix bffi:    <http://urn.fi/URN:NBN:fi:schema:bffi:> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix :        <#> .

# ---------------------------------------------------------------------------
# Skosmos global configuration. Mirrors the structure of
# `third_party/Skosmos/dockerfiles/config/config-docker-compose.ttl`
# but trimmed to what the BFFI pipeline actually needs. Skosmos refuses
# to start if config.ttl doesn't contain exactly one
# `skosmos:Configuration` resource, so this block is mandatory even
# when the per-vocabulary entry below carries its own SPARQL endpoint.
# ---------------------------------------------------------------------------

:config a skosmos:Configuration ;
    skosmos:sparqlEndpoint    <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect     "JenaText" ;
    skosmos:sparqlTimeout     20 ;
    skosmos:httpTimeout       5 ;
    skosmos:serviceName       "BFFI authority browser" ;
    # UI languages match the BFFI display priority committed in
    # CLAUDE.md: Finnish first, then Swedish, then English.
    skosmos:languages (
        [ rdfs:label "fi" ; rdf:value "fi_FI.utf8" ]
        [ rdfs:label "sv" ; rdf:value "sv_SE.utf8" ]
        [ rdfs:label "en" ; rdf:value "en_GB.utf8" ]
    ) ;
    skosmos:searchResultsSize    20 ;
    skosmos:transitiveLimit      1000 ;
    skosmos:rdfListItemsLimit    1000 ;
    skosmos:logCaughtExceptions  false ;
    skosmos:logBrowserConsole    false ;
    skosmos:templateCache        "/tmp/skosmos-template-cache" ;
    skosmos:customCss            "resource/css/stylesheet.css" ;
    skosmos:feedbackAddress      "" ;
    skosmos:feedbackSender       "" ;
    skosmos:feedbackEnvelopeSender "" ;
    skosmos:uiLanguageDropdown   false ;
    skosmos:uiHoneypotEnabled    true ;
    skosmos:uiHoneypotTime       5 ;
    skosmos:globalPlugins        () .

# ---------------------------------------------------------------------------
# Type labels — Skosmos requires rdfs:label on every custom type so
# the type filter in the UI shows human-readable names. The
# rdfs:subClassOf skos:Concept declarations also live in
# config/overlay/bffi-skos-overlay.ttl; restating them here keeps the
# Skosmos config self-contained for users who load Skosmos config
# without first parsing the bffi-works graph.
# ---------------------------------------------------------------------------

bffi:Work       rdfs:label      "Work"@en, "Teos"@fi, "Verk"@sv ;
                rdfs:subClassOf skos:Concept .

bffi:Expression rdfs:label      "Expression"@en, "Ekspressio"@fi, "Uttryck"@sv ;
                rdfs:subClassOf skos:Concept .

bffi:Manifestation rdfs:label   "Manifestation"@en, "Manifestaatio"@fi, "Manifestation"@sv ;
                   rdfs:subClassOf skos:Concept .

# ---------------------------------------------------------------------------
# Property labels — Skosmos renders the rdfs:label of each outgoing
# predicate as the property name on a concept page. Without these,
# Skosmos shows the raw URI of the predicate, which is uninformative.
# Labels mirror what lives in docs/lkd.rdf for the bffi:* predicates
# (re-stated here so Skosmos doesn't need to parse the full ontology).
#
# Hoisted onto each canonical Work / Expression / Manifestation by
# _synthesise_admin_metadata_highlights in
# src/bffi_pipeline/stages/m10/skosify_run.py — every cataloguer-
# relevant AdminMetadata field surfaces as a direct property row.
# ---------------------------------------------------------------------------

<http://purl.org/dc/terms/modified>
    rdfs:label "Last modified"@en, "Muokattu"@fi, "Ändrad"@sv .

<http://purl.org/dc/terms/conformsTo>
    rdfs:label "Conforms to"@en, "Mukainen"@fi, "Följer"@sv .

bffi:descriptionAuthentication
    rdfs:label "Description authentication"@en,
               "Kuvauksen autentikointi"@fi,
               "Beskrivningsautentisering"@sv .

bffi:descriptionLevel
    rdfs:label "Description level"@en,
               "Kuvailun tietomalli"@fi,
               "Beskrivningsnivå"@sv .

bffi:descriptionModifier
    rdfs:label "Description modifier"@en,
               "Muokkaava taho"@fi,
               "Modifierande aktör"@sv .

bffi:encodingLevel
    rdfs:label "Encoding level"@en,
               "Kuvailutaso"@fi,
               "Kodningsnivå"@sv .

bffi:generationDate
    rdfs:label "Generation date"@en,
               "Konversioajankohta"@fi,
               "Genereringsdatum"@sv .

# AdminMetadata-shaped fields not in the flatten table above. Same
# rationale — each appears on the canonical Work/Expression/Manifestation
# but Skosmos would render the bare URI without these labels.
# en/fi from docs/lkd.rdf; sv supplied by this project (not in lkd.rdf).

bffi:metadataLicensor
    rdfs:label "Metadata licensor"@en,
               "Metatiedon tekijänoikeus"@fi,
               "Metadatalicensgivare"@sv .

bffi:generationProcess
    rdfs:label "Generation process"@en,
               "Konversioprosessi"@fi,
               "Genereringsprocess"@sv .

bffi:sourceConsulted
    rdfs:label "Source consulted"@en,
               "Käytetty lähde"@fi,
               "Konsulterad källa"@sv .

bffi:recordingSource
    rdfs:label "Recording source"@en,
               "Merkintälähde"@fi,
               "Källa"@sv .

bffi:descriptionConventions
    rdfs:label "Description conventions"@en,
               "Kuvailusäännöt"@fi,
               "Beskrivningskonventioner"@sv .

bffi:adminMetadataFor
    rdfs:label "Administrative metadata for"@en,
               "Hallinnolliset metatiedot kohteelle"@fi,
               "Administrativ metadata för"@sv .

<http://www.w3.org/ns/prov#hadPrimarySource>
    rdfs:label "Primary source"@en,
               "Ensisijainen lähde"@fi,
               "Primärkälla"@sv .

# FRBR axis links — Work ↔ Expression ↔ Manifestation. Skosmos
# renders these as outgoing references; the property label gives
# them a human-readable column header. en/fi from docs/lkd.rdf.

bffi:hasExpression
    rdfs:label "Has expression"@en,
               "Teoksen ekspressio"@fi,
               "Har uttryck"@sv .

bffi:expressionOf
    rdfs:label "Expression of"@en,
               "Ekspression toteuttama teos"@fi,
               "Uttryck av"@sv .

bffi:expressionManifested
    rdfs:label "Expression manifested"@en,
               "Manifestaatioon sisältyvä ekspressio"@fi,
               "Manifesterad uttryck"@sv .

bffi:manifestationOfExpression
    rdfs:label "Manifestation of expression"@en,
               "Ekspression manifestaatio"@fi,
               "Manifestation av uttryck"@sv .

# Compilation aggregation — parent ↔ component for music compilations,
# anthologies, complete-works sets.

bffi:aggregates
    rdfs:label "Aggregates"@en,
               "Aggregoi ekspression"@fi,
               "Aggregerar"@sv .

bffi:aggregatedBy
    rdfs:label "Aggregated by"@en,
               "Aggregoija"@fi,
               "Aggregerad av"@sv .

# Subject / genre / form / language / content / carrier / media.
# The target URI's prefLabel already renders; these labels give the
# PROPERTY column its human name.

bffi:subject
    rdfs:label "Subject"@en,
               "Aihe"@fi,
               "Ämne"@sv .

# Typed-subject mirrors. ``_synthesise_typed_subject_display`` emits
# these parallel to ``bffi:subject`` so Skosmos renders temporal and
# geographic subjects under disambiguated rows instead of all
# collapsing into "Aihe". Each typed subject appears under BOTH the
# typed predicate and the catch-all ``bffi:subject`` (additive).

<http://purl.org/dc/terms/temporal>
    rdfs:label "Temporal subject"@en,
               "Ajallinen aihe"@fi,
               "Tidsmässigt ämne"@sv .

bffi:geographicCoverage
    rdfs:label "Geographic subject"@en,
               "Maantieteellinen aihe"@fi,
               "Geografiskt ämne"@sv .

bffi:genreForm
    rdfs:label "Genre/form"@en,
               "Kategoria"@fi,
               "Genre/form"@sv .

bffi:content
    rdfs:label "Content type"@en,
               "Sisältötyyppi"@fi,
               "Innehållstyp"@sv .

bffi:carrier
    rdfs:label "Carrier type"@en,
               "Tallennetyyppi"@fi,
               "Bärartyp"@sv .

bffi:media
    rdfs:label "Media type"@en,
               "Mediatyyppi"@fi,
               "Medietyp"@sv .

bffi:language
    rdfs:label "Language"@en,
               "Kieli"@fi,
               "Språk"@sv .

bffi:role
    rdfs:label "Contributor role"@en,
               "Rooli"@fi,
               "Roll"@sv .

bffi:creator
    rdfs:label "Creator"@en,
               "Tekijä"@fi,
               "Skapare"@sv .

# Contribution chain — the single Skosmos-facing row that groups
# agent + role. Skosmos walks one hop into the contribution bnode to
# read its ``skos:prefLabel`` (composed by
# ``_synthesise_contribution_labels`` as ``"<agent> (<role>)"``), so
# the cataloguer sees the pair on a single row instead of seeing
# ``dct:creator`` + ``bffi:role`` as two parallel rows on the concept
# page. The entity-level ``dct:creator`` / ``dct:contributor`` /
# ``bffi:role`` mirrors were removed from the Skosify output for
# this reason — see ``run()`` in ``skosify_run.py``.

bffi:contribution
    rdfs:label "Authorship"@en,
               "Tekijyys"@fi,
               "Författarskap"@sv .

# Title structure — main title, subtitle, part info, qualifier.

bffi:mainTitle
    rdfs:label "Main title"@en,
               "Nimekkeen merkkijono"@fi,
               "Huvudtitel"@sv .

bffi:subtitle
    rdfs:label "Subtitle"@en,
               "Muu nimeketieto"@fi,
               "Undertitel"@sv .

bffi:partNumber
    rdfs:label "Part number"@en,
               "Osan numero"@fi,
               "Delnummer"@sv .

bffi:partName
    rdfs:label "Part title"@en,
               "Osan nimeke"@fi,
               "Delbenämning"@sv .

bffi:qualifier
    rdfs:label "Qualifier"@en,
               "Tarkenne"@fi,
               "Kvalificering"@sv .

# Statements and descriptive fields surfaced via Skosify flatteners
# (responsibilityStatement / publicationStatement / etc. land directly
# on the Manifestation as literals).

bffi:responsibilityStatement
    rdfs:label "Statement of responsibility"@en,
               "Vastuullisuusmerkintö"@fi,
               "Ansvarsuppgift"@sv .

bffi:publicationStatement
    rdfs:label "Publication statement"@en,
               "Julkaisumerkintö"@fi,
               "Utgivningsuppgift"@sv .

bffi:editionStatement
    rdfs:label "Edition statement"@en,
               "Painosmerkintö"@fi,
               "Upplageuppgift"@sv .

bffi:dimensions
    rdfs:label "Dimensions"@en,
               "Koko"@fi,
               "Dimensioner"@sv .

bffi:summary
    rdfs:label "Summary"@en,
               "Sisällön yhteenveto"@fi,
               "Sammanfattning"@sv .

bffi:tableOfContents
    rdfs:label "Table of contents"@en,
               "Sisältöhuomautus"@fi,
               "Innehållsförteckning"@sv .

bffi:extent
    rdfs:label "Extent"@en,
               "Laajuus"@fi,
               "Omfång"@sv .

bffi:note
    rdfs:label "Note"@en,
               "Huomautus"@fi,
               "Anmärkning"@sv .

# Identifier / provision / classification / relation — these point at
# blank nodes Skosmos can't walk. The Skosify flatteners
# (_synthesise_identifier_predicates, _synthesise_provision_display,
# upcoming _synthesise_classification_display + _synthesise_note_text)
# lift the inner content to direct flat properties; these labels apply
# to the original predicates AND the flatteners' outputs.

bffi:identifiedBy
    rdfs:label "Identifier"@en,
               "Tunniste"@fi,
               "Identifierare"@sv .

bffi:provisionActivity
    rdfs:label "Provision activity"@en,
               "Tuottamistiedot"@fi,
               "Tillhandahållande"@sv .

bffi:classification
    rdfs:label "Classification"@en,
               "Luokitus"@fi,
               "Klassifikation"@sv .

bffi:classificationPortion
    rdfs:label "Classification number"@en,
               "Luokka"@fi,
               "Klassifikationsnummer"@sv .

bffi:relation
    rdfs:label "Relation"@en,
               "Suhde"@fi,
               "Relation"@sv .

bffi:associatedResource
    rdfs:label "Associated resource"@en,
               "Liittyvä aineisto"@fi,
               "Associerad resurs"@sv .

bffi:relationship
    rdfs:label "Relationship"@en,
               "Suhdetyyppi"@fi,
               "Relationstyp"@sv .

# ---------------------------------------------------------------------------
# Subject categorisation entry — referenced by the vocabulary's
# dc:subject so the Skosmos sidebar can group vocabularies by topic.
# ---------------------------------------------------------------------------

:catBibliographic a skosmos:Category ;
    rdfs:label "Bibliographic data"@en,
               "Kirjastoaineisto"@fi,
               "Bibliografisk data"@sv .

# ---------------------------------------------------------------------------
# Fuseki backend — stays on the docker-compose `fuseki` service.
# ---------------------------------------------------------------------------

:bibframeEndpoint a void:Dataset ;
    void:sparqlEndpoint <http://fuseki:3030/bffi/sparql> .

# ---------------------------------------------------------------------------
# The vocabulary entry. Per spec § 4:
#  - void:uriSpace MUST match the canonical Work URI prefix exactly,
#    otherwise Skosmos won't recognise internal links.
#  - skosmos:language order doubles as the display-language priority;
#    "fi", "sv", "en" matches Finland's official languages plus an
#    international fallback.
#  - skosmos:sparqlDialect "JenaText" enables the text:query predicate
#    Skosmos uses for fast label search; without it, search becomes
#    painfully slow at scale. Verify `jena-text` is enabled in the
#    Fuseki image (it is in stain/jena-fuseki:5.0.0).
#  - The two skosmos:indexShowClass entries are the user-facing type
#    filter committed in BUILD_PLAN M11.
# ---------------------------------------------------------------------------

:bffiWorks a skosmos:Vocabulary, void:Dataset ;
    dc:title          "Finnish Authority Works"@en,
                      "Suomalaiset auktoriteettiteokset"@fi,
                      "Finska auktoritetsverk"@sv ;
    skosmos:shortName "bffi-works"@en ;
    dc:subject        :catBibliographic ;
    void:uriSpace     "http://urn.fi/URN:NBN:fi:bib:work:" ;

    skosmos:language        "fi", "sv", "en" ;
    skosmos:defaultLanguage "fi" ;

    skosmos:sparqlGraph     <http://urn.fi/URN:NBN:fi:bib:graph:bffi-works> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;

    # Works only — Expressions live under the sibling ``:bffiExpressions``
    # vocab and Manifestations under ``:bffiManifestations``. Listing
    # ``bffi:Expression`` here too would double-count entries in the
    # alphabetical browse (Pre-P-45 this vocab was the combined
    # "Works + Expressions" surface; the three-sibling split made
    # Expressions their own browse).
    skosmos:indexShowClass  bffi:Work ;

    # Only the alphabetical browse(s) — Hierarchy, Groups and Changes
    # ("New") tabs are hidden because the BFFI corpus shape doesn't
    # match what those views are designed for (no canonical authority
    # hierarchy beyond W → E → M, no curated groups, and the
    # per-record dct:modified is the pipeline run timestamp rather
    # than a cataloguer edit). See Skosmos VocabularyConfig.php:
    # getSidebarViews — strings outside this list are ignored.
    skosmos:sidebarViews ( "alphabetical" ) ;

    skosmos:fullAlphabeticalIndex true .

# ---------------------------------------------------------------------------
# Three-class BFFI 1.0.0 ontology (P-45): Works, Expressions and
# Manifestations each get their own Skosmos vocabulary page so the URL
# routing (via ``void:uriSpace``) lands a user on the right entity-type
# index. All three share the SAME Fuseki named graph (``bffi-works``)
# because they're a single connected RDF graph in storage — the
# vocabulary separation is purely a UI navigation concern. The Work
# vocab keeps the original ``:bffiWorks`` short name so existing links
# (cataloguer-review bundles, judge audits) don't break.
# ---------------------------------------------------------------------------

:bffiExpressions a skosmos:Vocabulary, void:Dataset ;
    dc:title          "Finnish Authority Expressions"@en,
                      "Suomalaiset auktoriteettiekspressiot"@fi,
                      "Finska auktoritetsuttryck"@sv ;
    skosmos:shortName "bffi-expressions"@en ;
    dc:subject        :catBibliographic ;
    void:uriSpace     "http://urn.fi/URN:NBN:fi:bib:expression:" ;

    skosmos:language        "fi", "sv", "en" ;
    skosmos:defaultLanguage "fi" ;

    skosmos:sparqlGraph     <http://urn.fi/URN:NBN:fi:bib:graph:bffi-works> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;

    skosmos:indexShowClass  bffi:Expression ;

    # See :bffiWorks block above for rationale — alphabetical browse only.
    skosmos:sidebarViews ( "alphabetical" ) ;

    skosmos:fullAlphabeticalIndex true .

:bffiManifestations a skosmos:Vocabulary, void:Dataset ;
    dc:title          "Finnish Authority Manifestations"@en,
                      "Suomalaiset auktoriteettimanifestaatiot"@fi,
                      "Finska auktoritetsmanifestationer"@sv ;
    skosmos:shortName "bffi-manifestations"@en ;
    dc:subject        :catBibliographic ;
    void:uriSpace     "http://urn.fi/URN:NBN:fi:bib:manifestation:" ;

    skosmos:language        "fi", "sv", "en" ;
    skosmos:defaultLanguage "fi" ;

    skosmos:sparqlGraph     <http://urn.fi/URN:NBN:fi:bib:graph:bffi-works> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;

    skosmos:indexShowClass  bffi:Manifestation ;

    # See :bffiWorks block above for rationale — alphabetical browse only.
    skosmos:sidebarViews ( "alphabetical" ) ;

    skosmos:fullAlphabeticalIndex true .

# ---------------------------------------------------------------------------
# Finto-hosted vocabularies (KANTO/YSO/KAUNO/MUSO/SLM) — option 3b.
#
# M9 reconciliation binds canonical-Work creators to KANTO and subjects/
# genre-forms to YSO/KAUNO/MUSO/SLM URIs. To make those URIs render as
# labelled, clickable links in the Skosmos UI, we load the canonical
# Turtle dumps from api.finto.fi into our own Fuseki under each vocab's
# concept-scheme URI as the named graph (run via `bffi-pipeline
# load-finto` / `make refresh-finto`). The vocab declarations below tell
# Skosmos how to route URIs in the matching `void:uriSpace` to the right
# vocab page on our instance, and which named graph to query for labels.
#
# Per-vocab `skosmos:language` lists match each vocab's actual coverage
# (KANTO is fi-only; YSO adds `se`/Sami; KAUNO adds `en`). The shared
# Fuseki SPARQL endpoint + `JenaText` dialect mirror the bffiWorks vocab
# above so every vocab gets fast `text:query` label search.
# ---------------------------------------------------------------------------

:yso a skosmos:Vocabulary, void:Dataset ;
    dc:title          "YSO — General Finnish Ontology"@en,
                      "YSO — Yleinen suomalainen ontologia"@fi,
                      "YSO — Allmän finländsk ontologi"@sv ;
    skosmos:shortName "yso"@en ;
    void:uriSpace     "http://www.yso.fi/onto/yso/" ;
    skosmos:language        "fi", "sv", "en", "se" ;
    skosmos:defaultLanguage "fi" ;
    skosmos:sparqlGraph     <http://www.yso.fi/onto/yso/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:showTopConcepts       true ;
    skosmos:fullAlphabeticalIndex true .

:kanto a skosmos:Vocabulary, void:Dataset ;
    dc:title          "KANTO — Finnish national name authorities"@en,
                      "KANTO — Kansalliset toimijatiedot"@fi ;
    skosmos:shortName "kanto"@en ;
    void:uriSpace     "http://urn.fi/URN:NBN:fi:au:finaf:" ;
    skosmos:language        "fi" ;
    skosmos:defaultLanguage "fi" ;
    skosmos:sparqlGraph     <http://urn.fi/URN:NBN:fi:au:finaf:> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

:kauno a skosmos:Vocabulary, void:Dataset ;
    dc:title          "KAUNO — Ontology of fictive subjects"@en,
                      "KAUNO — Fiktiivisen aineiston ontologia"@fi,
                      "KAUNO — Ontologi för fiktiva ämnesord"@sv ;
    skosmos:shortName "kauno"@en ;
    void:uriSpace     "http://www.yso.fi/onto/kauno/" ;
    skosmos:language        "fi", "sv", "en" ;
    skosmos:defaultLanguage "fi" ;
    skosmos:sparqlGraph     <http://www.yso.fi/onto/kauno/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:showTopConcepts       true ;
    skosmos:fullAlphabeticalIndex true .

:muso a skosmos:Vocabulary, void:Dataset ;
    dc:title          "MUSO — Music ontology"@en,
                      "MUSO — Musiikin ontologia"@fi,
                      "MUSO — Musikontologi"@sv ;
    skosmos:shortName "muso"@en ;
    void:uriSpace     "http://www.yso.fi/onto/muso/" ;
    skosmos:language        "fi", "sv" ;
    skosmos:defaultLanguage "fi" ;
    skosmos:sparqlGraph     <http://www.yso.fi/onto/muso/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:showTopConcepts       true ;
    skosmos:fullAlphabeticalIndex true .

:slm a skosmos:Vocabulary, void:Dataset ;
    dc:title          "SLM — Finnish genre/form thesaurus"@en,
                      "SLM — Suomalainen lajityyppi- ja muotosanasto"@fi,
                      "SLM — Finsk genre- och formordlista"@sv ;
    skosmos:shortName "slm"@en ;
    void:uriSpace     "http://urn.fi/URN:NBN:fi:au:slm:" ;
    skosmos:language        "fi", "sv" ;
    skosmos:defaultLanguage "fi" ;
    skosmos:sparqlGraph     <http://urn.fi/URN:NBN:fi:au:slm:> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:showTopConcepts       true ;
    skosmos:fullAlphabeticalIndex true .

# LoC MARC Code List for Relators — labels the bf:role URIs emitted by
# the M3 contributor-extraction cascade (e.g. relators/trl for
# translator). English-only; downstream Finnish-UI sessions still
# render the labels because Skosmos falls back when only one language
# is available.
:relators a skosmos:Vocabulary, void:Dataset ;
    dc:title          "MARC Code List for Relators"@en ;
    skosmos:shortName "relators"@en ;
    void:uriSpace     "http://id.loc.gov/vocabulary/relators/" ;
    skosmos:language        "en" ;
    skosmos:defaultLanguage "en" ;
    skosmos:sparqlGraph     <http://id.loc.gov/vocabulary/relators/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# LC Genre/Form Terms — Helmet cataloguers cite English LCGFT URIs on
# MARC 655 fields (e.g. genreForms/gf2015026020 for "Novels"). Loading
# the dump lets Skosmos render those URIs as labelled clickable
# concepts and lets graph_uri_for_uri recognise them so M9 walkers
# correctly skip them as already-resolved.
:lcgft a skosmos:Vocabulary, void:Dataset ;
    dc:title          "LC Genre/Form Terms"@en ;
    skosmos:shortName "lcgft"@en ;
    void:uriSpace     "http://id.loc.gov/authorities/genreForms/" ;
    skosmos:language        "en" ;
    skosmos:defaultLanguage "en" ;
    skosmos:sparqlGraph     <http://id.loc.gov/authorities/genreForms/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# LC Subject Headings — the general English subject thesaurus.
# Cataloguers occasionally use $2 lcsh for topical subjects on records
# copied or harmonised from English-language sources. Tier-0 routes
# subject-kind requests through both YSO and LCSH so those English
# literals bind deterministically without a Finto API call.
:lcsh a skosmos:Vocabulary, void:Dataset ;
    dc:title          "LC Subject Headings"@en ;
    skosmos:shortName "lcsh"@en ;
    void:uriSpace     "http://id.loc.gov/authorities/subjects/" ;
    skosmos:language        "en" ;
    skosmos:defaultLanguage "en" ;
    skosmos:sparqlGraph     <http://id.loc.gov/authorities/subjects/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# KAUNOKKI/BELLA — Finto fiction thesaurus, the legacy KAUNO form with
# Swedish parallel labels under the Bella sub-vocab. Loaded so that
# $2 kaunokki / $2 bella-tagged URIs render as labelled clickable
# concepts in Skosmos.
:kaunokki a skosmos:Vocabulary, void:Dataset ;
    dc:title          "KAUNOKKI/BELLA — fiktiivisen aineiston sanasto"@fi,
                      "KAUNOKKI/BELLA — vocabulary for fictional material"@en ;
    skosmos:shortName "kaunokki"@fi,
                      "kaunokki"@sv,
                      "kaunokki"@en ;
    void:uriSpace     "http://urn.fi/URN:NBN:fi:au:kaunokki:" ;
    skosmos:language        "fi", "sv" ;
    skosmos:defaultLanguage "fi" ;
    skosmos:sparqlGraph     <http://urn.fi/URN:NBN:fi:au:kaunokki:> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# Allärs — Swedish general subjects thesaurus (Allmän tesaurus på
# svenska). Swedish-language parallel to YSA/YSO; cataloguers tag
# $2 allars on Swedish-language MARC 6XX subjects.
:allars a skosmos:Vocabulary, void:Dataset ;
    dc:title          "Allärs — Allmän tesaurus på svenska"@sv,
                      "Allars — Swedish general thesaurus"@en ;
    skosmos:shortName "allars"@sv,
                      "allars"@en ;
    void:uriSpace     "http://www.yso.fi/onto/allars/" ;
    skosmos:language        "sv" ;
    skosmos:defaultLanguage "sv" ;
    skosmos:sparqlGraph     <http://www.yso.fi/onto/allars/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# RDA Media Types — labels the bf:media URIs forwarded onto each
# bffi:Manifestation by M3 (P-45 commit 4). One of two LoC RDA vocabs
# the Manifestation page leans on; ``rda-media`` matches the
# ``vocab_id`` in ``load-finto``'s ``FINTO_VOCABS``.
:rda-media a skosmos:Vocabulary, void:Dataset ;
    dc:title          "RDA Media Types"@en ;
    skosmos:shortName "rda-media"@en ;
    void:uriSpace     "http://id.loc.gov/vocabulary/mediaTypes/" ;
    skosmos:language        "en", "fi", "sv" ;
    skosmos:defaultLanguage "en" ;
    skosmos:sparqlGraph     <http://id.loc.gov/vocabulary/mediaTypes/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# RDA Carrier Types — labels the bf:carrier URIs forwarded onto each
# bffi:Manifestation by M3 (P-45 commit 4).
:rda-carrier a skosmos:Vocabulary, void:Dataset ;
    dc:title          "RDA Carrier Types"@en ;
    skosmos:shortName "rda-carrier"@en ;
    void:uriSpace     "http://id.loc.gov/vocabulary/carriers/" ;
    skosmos:language        "en", "fi", "sv" ;
    skosmos:defaultLanguage "en" ;
    skosmos:sparqlGraph     <http://id.loc.gov/vocabulary/carriers/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

# MARC 007-derived format-detail vocabs (P-45 commit 17):
# Six small LoC vocabularies surfaced on Manifestation pages to
# distinguish what the coarse RDA carrier collapses — DVD vs Blu-ray,
# audio CD vs vinyl LP, color vs B&W, etc. All MADS-shaped at LoC;
# ``load-finto``'s MADS→SKOS lift produces the SKOS labels Skosmos
# needs. Each ~5-10 KB.
:mencformat a skosmos:Vocabulary, void:Dataset ;
    dc:title          "MARC encoding format codes"@en ;
    skosmos:shortName "mencformat"@en ;
    void:uriSpace     "http://id.loc.gov/vocabulary/mencformat/" ;
    skosmos:language        "en", "fi", "sv" ;
    skosmos:defaultLanguage "en" ;
    skosmos:sparqlGraph     <http://id.loc.gov/vocabulary/mencformat/> ;
    skosmos:sparqlEndpoint  <http://fuseki:3030/bffi/sparql> ;
    skosmos:sparqlDialect   "JenaText" ;
    skosmos:fullAlphabeticalIndex true .

